@model IEnumerable<CinemaVN.Models.ChiNhanh>

@{
    ViewData["Title"] = "Hệ thống Rạp chiếu phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="min-height: 70vh;">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase text-danger">Hệ thống Rạp CinemaVN</h2>
        <p class="text-muted">Tìm rạp gần bạn nhất để thưởng thức những bộ phim đỉnh cao!</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-4 col-md-5 mb-4 mb-md-0">
                <div class="list-group shadow-sm" style="max-height: 550px; overflow-y: auto;">
                    @foreach (var cn in Model)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action p-3 branch-item border-start-0 border-end-0 border-top-0"
                                onclick="changeMap('@cn.DiaChi', '@cn.TenCn', this)">
                            <div class="d-flex align-items-center">
                                <div class="bg-danger text-white rounded-circle d-flex justify-content-center align-items-center me-3 flex-shrink-0"
                                     style="width: 50px; height: 50px;">
                                    <i class="bi bi-geo-alt-fill fs-4"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">@cn.TenCn</h5>
                                    <p class="mb-1 text-muted small text-truncate" style="max-width: 200px;" title="@cn.DiaChi">
                                        <i class="bi bi-map text-danger"></i> @cn.DiaChi
                                    </p>
                                    <p class="mb-0 text-muted small">
                                        <i class="bi bi-telephone-fill text-success"></i> @(string.IsNullOrEmpty(cn.Sdt) ? "Đang cập nhật" : cn.Sdt)
                                    </p>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div class="col-lg-8 col-md-7">
                <div class="card shadow-sm border-0 h-100 rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white text-center py-3">
                        <h5 class="mb-0 fw-bold" id="mapTitle">Đang tải bản đồ...</h5>
                    </div>
                    <div class="card-body p-0" style="min-height: 500px;">

                        <iframe id="googleMap"
                                width="100"
                                height="100"
                                style="width:100%; height:100%; border:0; min-height: 500px;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                src="">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Hệ thống đang cập nhật danh sách rạp.</h4>
        </div>
    }
</div>

<!-- SCRIPT XỬ LÝ ĐỔI BẢN ĐỒ -->
<script>
    function changeMap(address, name, element) {
        // 1. Cập nhật tiêu đề rạp trên đầu bản đồ
        document.getElementById('mapTitle').innerText = 'Bản đồ đường đi: ' + name;

        // 2. Encode địa chỉ để đưa vào URL (Thêm chữ Vietnam để Google Maps tìm chính xác hơn)
        let encodedAddress = encodeURIComponent(address + ', Vietnam');

        // 3. Thay đổi src của iframe Google Maps
        // Thông số z=15 là độ zoom (phóng to/thu nhỏ)
        let mapUrl = `https://maps.google.com/maps?q=${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
        document.getElementById('googleMap').src = mapUrl;

        // 4. Hiệu ứng UX: Đổi màu nền của rạp đang được chọn
        let items = document.querySelectorAll('.branch-item');
        items.forEach(i => {
            i.classList.remove('bg-light', 'border-danger', 'border-4');
        });

        // Thêm viền đỏ bên trái cho rạp đang active
        element.classList.add('bg-light', 'border-danger', 'border-4');
        element.style.borderLeftStyle = 'solid';
    }

    // Tự động trigger click vào rạp đầu tiên khi vừa mở trang web
    document.addEventListener("DOMContentLoaded", function() {
        let firstBranch = document.querySelector('.branch-item');
        if (firstBranch) {
            firstBranch.click();
        }
    });
</script>