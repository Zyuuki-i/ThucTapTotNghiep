@model List<DichVu>

@{
    ViewData["Title"] = "Chọn Dịch Vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var gheIds = ViewBag.GheIds;
    var masc = ViewBag.MaSc;
    List<KhuyenMai>? dsKM = ViewBag.KhuyenMais as List<KhuyenMai>;
}

<div class="container text-center mb-5">
    <h4 class="my-5 text-uppercase text-info">Chọn dịch vụ</h4>

    <form method="post" action="ThanhToan">

        <input type="hidden" name="masc" value="@masc" />
        <input type="hidden" name="gheIds" value="@gheIds" />
        <input type="hidden" name="maKm" id="maKm" />

        <div class="row">
            @foreach (var dv in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card p-3 text-center">
                        <img src="@Url.Content("~/images/snacks/" + (dv.HinhAnh??"default.png") )" class="movie-img" style="height:250px">

                        <h5 class="mt-2">@dv.TenDv</h5>
                        <p>@dv.Gia.ToString("N0") đ</p>

                        <input type="number"
                               name="soLuong_@dv.MaDv"
                               value="0" min="0"
                               class="form-control text-center" />

                    </div>
                </div>
            }
        </div>

        <h4 class="my-4 text-uppercase text-info">Áp dụng khuyến mãi</h4>
        <div class="w-100 fs-4 text-end text-warning my-2"><p>Số điểm khả dụng: @ViewBag.SoDiemKhaDung</p></div>
        <div class="row">
            @if (dsKM != null && dsKM.Count > 0)
            {
                foreach (var km in dsKM)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card shadow-sm h-100 km-item"
                             onclick="chonKM(@km.MaKm, this)"
                             style="cursor:pointer">

                            <div class="card-body">
                                <h5 class="card-title text-danger">
                                    @km.Code
                                </h5>

                                <p class="mb-1">
                                    Giảm: <b>@km.PhanTramGiam% - Tối đa: @km.GiamToiDa?.ToString("N0")</b>
                                </p>

                                <p class="mb-1 text-muted small">
                                    Cần: @km.SoDiem điểm
                                </p>

                                <p class="text-muted small">
                                    HSD: @km.NgayKt?.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Không có khuyến mãi phù hợp</p>
            }
        </div>

        <button type="submit" class="btn btn-success fs-4 w-100 mt-3">
            Thanh Toán
        </button>
    </form>
</div>
<script>
    function chonKM(maKm, el) {
        document.getElementById("maKm").value = maKm;

        document.querySelectorAll(".km-item").forEach(x => {
            x.classList.remove("border", "border-danger");
        });

        el.classList.add("border", "border-danger");
    }
</script>