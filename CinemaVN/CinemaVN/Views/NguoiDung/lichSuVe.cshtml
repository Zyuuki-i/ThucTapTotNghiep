@model IEnumerable<CinemaVN.Models.HoaDon>

@{
    ViewData["Title"] = "lichSuVe";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal? tongTienDV = 0;
}

<div class="container py-4 my-4 border rouded shadow align-content-center" style="min-height:500px">

    @if (Model != null && Model.Any())
    {
        @foreach (var hoadon in Model)
        {
            <div class="card mb-3 shadow-sm border-0 position-relative overflow-hidden" style="border-radius: 10px;">       

                <div class="card-body d-flex align-items-center px-4">
                    <div class="me-3">
                        @if (hoadon.Ves != null && hoadon.Ves.Any())
                        {
                            var phim = hoadon.Ves.First().MaScNavigation?.MaPhimNavigation;
                            var hinh = phim?.Poster ?? "default.png";
                            var link = "/images/posters/" + hinh;
                            <img src="@Url.Content(link)" alt="poster" class="rounded" style="width: 80px; height: 110px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-primary rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 110px;">
                                <i class="bi bi-cup-straw text-white fs-1"></i>
                            </div>
                        }
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="mb-1 fw-bold text-dark">
                            @(hoadon.Ves != null && hoadon.Ves.Any() ? hoadon.Ves.First().MaScNavigation?.MaPhimNavigation?.TenPhim : "Combo/Sản phẩm")
                        </h5>
                        
                        <p class="mb-1 text-muted small">
                            @if (hoadon.Ves != null && hoadon.Ves.Any())
                            {
                                <span>@(hoadon.Ves?.First().MaScNavigation?.MaDdNavigation?.TenDd??"")</span>
                                int tuoi = hoadon.Ves?.First().MaScNavigation?.MaPhimNavigation?.DoTuoi ?? 0;
                                if(tuoi == 0)
                                {
                                    <span class="badge bg-success text-dark ms-2">P</span>
                                }else if (tuoi == 13)
                                {
                                    <span class="badge bg-info text-dark ms-2">T13</span>
                                }
                                else if (tuoi == 16)
                                {
                                    <span class="badge bg-warning text-dark ms-2">T16</span>
                                }
                                else if (tuoi == 18)
                                {
                                    <span class="badge bg-danger text-dark ms-2">T18</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-dark ms-2">C</span>
                                }
                            }
                            else if (hoadon.ChiTietDichVus != null && hoadon.ChiTietDichVus.Any())
                            {
                                @foreach(var dv in hoadon.ChiTietDichVus) {
                                    <span>1x Item: @dv.MaDvNavigation?.TenDv</span>
                                    tongTienDV += dv.DonGia * dv.SoLuong;
                                }
                            }
                        </p>
                    </div>
                    <div class="d-flex flex-column">
                        <div class="text-muted small">@hoadon.MaCnNavigation?.TenCn</div>
                        <div class="fw-bold">
                            @if (hoadon.Ves != null && hoadon.Ves.Any())
                            {
                                <span>@hoadon.Ves?.First().MaScNavigation?.GioBd - @hoadon.Ves?.First().MaScNavigation?.NgayChieu?.ToString("dd/MM/yyyy")</span>
                            }else
                            {
                                <span>@tongTienDV?.ToString("N0") đ</span>
                            }
                        </div>
                    </div>
                    <div class="ms-4">
                        <button class="btn text-warning fw-bold p-0"
                                onclick="loadChiTiet(@hoadon.MaHd)">
                            Chi tiết
                        </button>
                    </div>
                </div>  
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <p>Bạn chưa có giao dịch nào.</p>
        </div>
    }
</div>

<div class="modal fade" id="chiTietModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Chi tiết hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="modalContent">
                <div class="text-center">Đang tải...</div>
            </div>

        </div>
    </div>
</div>

<script>
    function loadChiTiet(maHd) {
        fetch('/NguoiDung/chiTietVe/' + maHd)
            .then(res => res.text())
            .then(html => {
                document.getElementById('modalContent').innerHTML = html;

                var modal = new bootstrap.Modal(document.getElementById('chiTietModal'));
                modal.show();
            });
    }
</script>