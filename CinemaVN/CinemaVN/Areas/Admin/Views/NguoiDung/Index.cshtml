@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-3">
    <h2 class="text-label fw-bold mb-0 text-uppercase">
        <i class="bi bi-box-seam"></i> Quản Lý Người Dùng
    </h2>
</div>

<div class="d-flex justify-content-center align-items-center gap-5 flex-wrap main-box">

    <a asp-action="quanLy" class="menu-card bg-danger">
        <i class="bi bi-person-gear"></i>
        <span>Quản lý</span>
    </a>

    <a asp-action="nhanVien" class="menu-card bg-info">
        <i class="bi bi-people"></i>
        <span>Nhân viên</span>
    </a>

    <a asp-action="khachHang" class="menu-card bg-success">
        <i class="bi bi-person"></i>
        <span>Khách hàng</span>
    </a>

</div>