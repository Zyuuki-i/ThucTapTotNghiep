@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-label text-center">QUẢN LÝ NGƯỜI DÙNG</h1>

<div class="d-flex justify-content-center align-items-center gap-5 flex-wrap main-box">

    <a asp-action="quanLy" class="menu-card bg-danger">
        <i class="bi bi-person-gear"></i>
        <span>Quản lý</span>
    </a>

    <a asp-action="nhanVien" class="menu-card bg-info">
        <i class="bi bi-people"></i>
        <span>Nhân viên</span>
    </a>

    <a asp-action="khachHang" class="menu-card bg-success">
        <i class="bi bi-person"></i>
        <span>Khách hàng</span>
    </a>

</div>