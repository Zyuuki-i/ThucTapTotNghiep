@model CinemaVN.DatModels.CChiNhanh

@{
    ViewData["Title"] = "Thêm Chi Nhánh";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-label fw-bold text-uppercase">
    <i class="bi bi-people"></i> Quản Lý Chi Nhánh
</h2>
<div class="row mb-2">
    <div class="col-5"><hr /></div>
    <div class="col-2 text-center">
        <h3 class="text-success">THÊM MỚI</h3>
    </div>
    <div class="col-5"><hr /></div>
    <div class="col-12 text-center">
        <a class="btn btn-outline-info w-25" asp-action="Index">Quay lại</a>
    </div>
</div>
@if (TempData["MessageError_ThemChiNhanh"] != null)
{
    <div class="alert alert-danger text-center fw-bold">
        @TempData["MessageError_ThemChiNhanh"]
    </div>
}
<div class="border border-3 border-success p-3 rounded">
    <div class="row">
        <form asp-action="themCN" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaCn" class="control-label"></label>
                <input asp-for="MaCn" class="form-control" />
                <span asp-validation-for="MaCn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TenCn" class="control-label"></label>
                <input asp-for="TenCn" class="form-control" />
                <span asp-validation-for="TenCn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiaChi" class="control-label"></label>
                <input asp-for="DiaChi" class="form-control" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sdt" class="control-label"></label>
                <input asp-for="Sdt" class="form-control" />
                <span asp-validation-for="Sdt" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end mt-2">
                <input type="submit" value="Thêm" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.querySelector(".alert");
        if (alertBox) {
            setTimeout(() => alertBox.style.display = "none", 10000);
        }
    });
</script>
