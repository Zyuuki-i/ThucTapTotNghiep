@model IEnumerable<CinemaVN.DatModels.CChiNhanh>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-label text-center">QUẢN LÝ CHI NHÁNH</h1>

<div class="w-100 d-flex justify-content-between">
    <a asp-action="them" class="btn btn-label btn-success">Thêm Mới</a>
    <div class="d-flex justify-content-between">
        <form class="d-flex search-group me-1" method="get" asp-action="Index">
            <div class="input-group">
                <input class="form-control" type="search" name="keyword" placeholder="Tìm mã, tên, địa chỉ,..." value="@ViewBag.Keyword" aria-label="Search">
                <button class="btn btn-search bg-black text-white" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
        @if (ViewBag.keyword != null && ViewBag.keyword != "")
        {
            <a asp-action="Index" class="btn btn-outline-info me-1">Quay lại</a>
        }
    </div>
</div>
<div class="my-3">
    @if (TempData["MessageError_ChiNhanh"] != null)
    {
        <div class="alert alert-danger text-center fw-bold">
            @TempData["MessageError_ChiNhanh"]
        </div>
    }
    @if (TempData["MessageSuccess_ChiNhanh"] != null)
    {
        <div class="alert alert-success text-center fw-bold">
            @TempData["MessageSuccess_ChiNhanh"]
        </div>
    }
</div>
<div class="mt-3">
    <table class="table table-bordered text-center align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.MaCn)</th>
                <th>@Html.DisplayNameFor(model => model.TenCn)</th>
                <th>@Html.DisplayNameFor(model => model.DiaChi)</th>
                <th>@Html.DisplayNameFor(model => model.Sdt)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaCn</td>
                        <td>@item.TenCn</td>
                        <td>@item.DiaChi</td>
                        <td>@item.Sdt</td>
                        <td>
                            <a asp-action="xoa" asp-route-id="@item.MaCn" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa chi nhánh @(item.TenCn ?? "này")?');">Xóa</a>
                            <a asp-action="sua" asp-route-id="@item.MaCn" class="btn btn-sm btn-primary">Sửa</a>
                            @* <a asp-action="chiTiet" asp-route-id="@item.MaCn" class="btn btn-sm btn-info">Chi Tiết</a> *@
                        </td>
                    </tr>
                }
                @if (ViewBag.tongTrang != null && ViewBag.tongTrang > 1)
                {
                    <tr>
                        <td colspan="5">
                            <div class="d-flex justify-content-center mt-3">
                                @{
                                    int trangHT = ViewBag.trangHT ?? 1;
                                    int tongTrang = ViewBag.tongTrang ?? 1;
                                    string? keyword = ViewBag.Keyword as string;
                                }
                                @if (tongTrang > 1)
                                {
                                    <ul class="pagination">

                                        <!-- Prev -->
                                        <li class="page-item @(trangHT == 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-keyword="@keyword"
                                               asp-route-trang="1">«</a>
                                        </li>

                                        <!-- Pages -->
                                        @for (int i = 1; i <= tongTrang; i++)
                                        {
                                            <li class="page-item @(i == trangHT ? "active" : "")">
                                                <a class="page-link"
                                                   asp-action="Index"
                                                   asp-route-keyword="@keyword"
                                                   asp-route-trang="@i">@i</a>
                                            </li>
                                        }

                                        <!-- Next -->
                                        <li class="page-item @(trangHT == tongTrang ? "disabled" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-keyword="@keyword"
                                               asp-route-trang="@(tongTrang)">»</a>
                                        </li>
                                    </ul>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">Không có chi nhánh nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.querySelector(".alert");
        if (alertBox) {
            setTimeout(() => alertBox.style.display = "none", 10000);
        }
    });
</script>