@model CinemaVN.DatModels.CKhuyenMai

@{
    ViewData["Title"] = "Sửa Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-label fw-bold text-uppercase">
    <i class="bi bi-gift"></i> Quản Lý Khuyến Mãi
</h2>
<div class="row mb-2">
    <div class="col-5"><hr /></div>
    <div class="col-2 text-center">
        <h3 class="text-primary">CẬP NHẬT</h3>
    </div>
    <div class="col-5"><hr /></div>
    <div class="col-12 text-center">
        <a class="btn btn-outline-info w-25" asp-action="Index">Quay lại</a>
    </div>
</div>
@if (TempData["MessageError_SuaKhuyenMai"] != null)
{
    <div class="alert alert-danger text-center fw-bold">
        @TempData["MessageError_SuaKhuyenMai"]
    </div>
}
<div class="border border-3 border-primary p-3 rounded">
    <div class="row">
        <form asp-action="sua" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaKm" class="control-label"></label>
                <input asp-for="MaKm" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Code" class="control-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MoTa" class="control-label"></label>
                <input asp-for="MoTa" class="form-control" />
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DieuKien" class="control-label"></label>
                <input asp-for="DieuKien" class="form-control" />
                <span asp-validation-for="DieuKien" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoDiem" class="control-label"></label>
                <input asp-for="SoDiem" class="form-control" />
                <span asp-validation-for="SoDiem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhanTramGiam" class="control-label"></label>
                <input asp-for="PhanTramGiam" class="form-control" />
                <span asp-validation-for="PhanTramGiam" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GiamToiDa" class="control-label"></label>
                <input asp-for="GiamToiDa" class="form-control" />
                <span asp-validation-for="GiamToiDa" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NgayBd" class="control-label"></label>
                <input asp-for="NgayBd" type="date" class="form-control" />
                <span asp-validation-for="NgayBd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NgayKt" class="control-label"></label>
                <input asp-for="NgayKt" type="date" class="form-control" />
                <span asp-validation-for="NgayKt" class="text-danger"></span>
            </div>
            <input asp-for="TrangThai" class="form-control" type="hidden" />
            <div class="form-group d-flex justify-content-end mt-2">
                <input type="submit" value="Cập nhật" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.querySelector(".alert");
        if (alertBox) {
            setTimeout(() => alertBox.style.display = "none", 10000);
        }
    });
</script>

