@model IEnumerable<CinemaVN.DatModels.CKhuyenMai>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-label text-center">QUẢN LÝ KHUYẾN MÃI</h1>

<div class="w-100 d-flex justify-content-between">
    <a asp-action="them" class="btn btn-label btn-success">Thêm Mới</a>
    <div class="d-flex justify-content-evenly" style="width:450px">
        <span class="fs-5 text-warning me-2">Sắp diễn ra: @ViewBag.demSapDienRa</span>
        <span class="fs-5 text-success me-2">Hiệu lực: @ViewBag.demHieuLuc</span>
        <span class="fs-5 text-danger">Hết hạn: @ViewBag.demHetHan</span>
    </div>
    <div class="d-flex justify-content-between">
        <form class="d-flex search-group me-1" method="get" asp-action="Index">
            <div class="input-group">
                <input class="form-control" type="search" name="keyword" placeholder="Tìm mã, code" value="@ViewBag.Keyword" aria-label="Search">
                <button class="btn btn-search bg-black text-white" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
        @if (ViewBag.Keyword != null && ViewBag.Keyword != "")
        {
            <a asp-action="Index" class="btn btn-outline-info me-1">Quay lại</a>
        }
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">

            <select name="trangthai" class="form-select w-auto" onchange="this.form.submit()">
                <option value="-1">Tất cả</option>
                @{
                    var trangThai = ViewBag.TrangThai?.ToString();
                }
                <option value="0" selected="@(trangThai == "0" ? "selected" : null)">
                    Sắp diễn ra
                </option>
                <option value="1" selected="@(trangThai == "1" ? "selected" : null)">
                    Hiệu lực
                </option>
                <option value="2" selected="@(trangThai == "2" ? "selected" : null)">
                    Hết hạn
                </option>
            </select>
        </form>
    </div>
</div>
<div class="my-3">
    @if (TempData["MessageError_KhuyenMai"] != null)
    {
        <div class="alert alert-danger text-center fw-bold">
            @TempData["MessageError_KhuyenMai"]
        </div>
    }
    @if (TempData["MessageSuccess_KhuyenMai"] != null)
    {
        <div class="alert alert-success text-center fw-bold">
            @TempData["MessageSuccess_KhuyenMai"]
        </div>
    }
</div>
<div class="mt-3">
    <table class="table table-bordered text-center align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.MaKm)</th>
                <th>@Html.DisplayNameFor(model => model.Code)</th>
                <th>@Html.DisplayNameFor(model => model.DieuKien)</th>
                <th>@Html.DisplayNameFor(model => model.SoDiem)</th>
                <th>Quyền lợi</th>
                <th>Thời gian</th>
                <th>@Html.DisplayNameFor(model => model.TrangThai)</th>
                <th>@Html.DisplayNameFor(model => model.MoTa)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaKm</td>
                        <td>@item.Code</td>
                        <td>@item.DieuKien?.ToString("N0")đ</td>
                        <td>@item.SoDiem</td>
                        <td>@(item.PhanTramGiam)% tối đa @item.GiamToiDa?.ToString("N0")đ</td>
                        <td>@item.NgayBd?.ToShortDateString() - @item.NgayKt?.ToShortDateString()</td>
                        <td>
                            <form method="post" asp-action="doiTrangThai" asp-route-id="@item.MaKm">
                                <select name="trangthai" onchange="this.form.submit()"
                                        class="form-select form-select-sm 
                                        @(item.TrangThai == 0 ? "bg-warning" : item.TrangThai == 1 ? "bg-success" : "bg-danger")">
                                    <option value="0" selected="@(item.TrangThai == 0 ? "selected" : null)">Sắp diễn ra</option>
                                    <option value="1" selected="@(item.TrangThai == 1 ? "selected" : null)">Hiệu lực</option>
                                    <option value="2" selected="@(item.TrangThai == 2 ? "selected" : null)">Hết hạn</option>
                                </select>
                            </form>
                        </td>
                        <td style="min-width:150px; max-width:150px; height:50px; overflow:hidden; text-overflow:ellipsis;">@item.MoTa</td>
                        <td>
                            <a asp-action="xoa" asp-route-id="@item.MaKm" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa khuyến mãi @(item.Code ?? "này")?');">Xóa</a>
                            <a asp-action="sua" asp-route-id="@item.MaKm" class="btn btn-sm btn-primary">Sửa</a>
                        </td>
                    </tr>
                }
                @if (ViewBag.tongTrang != null && ViewBag.tongTrang > 1)
                {
                    <tr>
                        <td colspan="9">
                            <div class="d-flex justify-content-center mt-3">
                                @{
                                    int trangHT = ViewBag.trangHT ?? 1;
                                    int tongTrang = ViewBag.tongTrang ?? 1;
                                    string? keyword = ViewBag.Keyword as string;
                                    int trangthai = ViewBag.TrangThai ?? 1;
                                }
                                @if (tongTrang > 1)
                                {
                                    <ul class="pagination">

                                        <!-- Prev -->
                                        <li class="page-item @(trangHT == 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-keyword="@keyword"
                                               asp-route-trangthai="@trangthai"
                                               asp-route-trang="1">«</a>
                                        </li>

                                        <!-- Pages -->
                                        @for (int i = 1; i <= tongTrang; i++)
                                        {
                                            <li class="page-item @(i == trangHT ? "active" : "")">
                                                <a class="page-link"
                                                   asp-action="Index"
                                                   asp-route-keyword="@keyword"
                                                   asp-route-trangthai="@trangthai"
                                                   asp-route-trang="@i">@i</a>
                                            </li>
                                        }

                                        <!-- Next -->
                                        <li class="page-item @(trangHT == tongTrang ? "disabled" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-keyword="@keyword"
                                               asp-route-trangthai="@trangthai"
                                               asp-route-trang="@(tongTrang)">»</a>
                                        </li>
                                    </ul>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12">Không có khuyến mãi nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.querySelector(".alert");
        if (alertBox) {
            setTimeout(() => alertBox.style.display = "none", 10000);
        }
    });
</script>