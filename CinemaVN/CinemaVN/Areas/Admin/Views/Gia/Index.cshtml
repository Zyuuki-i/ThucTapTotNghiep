@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-label text-center">QUẢN LÝ GIÁ</h1>

<div class="d-flex justify-content-center align-items-center gap-5 flex-wrap main-box">

    <a asp-action="loaiGhe" class="menu-card bg-primary">
        <i class="bi bi-grid-3x3-gap-fill"></i>
        <span>Loại ghế</span>
    </a>

    <a asp-action="dinhDang" class="menu-card bg-info">
        <i class="bi bi-badge-hd-fill"></i>
        <span>Định dạng</span>
    </a>

    <a asp-action="dichVu" class="menu-card bg-success">
        <i class="bi bi-cup-straw"></i>
        <span>Dịch vụ</span>
    </a>

</div>