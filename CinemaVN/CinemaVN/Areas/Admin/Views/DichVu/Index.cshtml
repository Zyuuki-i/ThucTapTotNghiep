@model IEnumerable<CinemaVN.Models.DichVu>
@{
    ViewData["Title"] = "Quản lý Danh Mục Dịch Vụ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    
    int totalItems = Model.Count();
    int totalCategories = Model.Select(d => d.LoaiDv).Where(l => !string.IsNullOrEmpty(l)).Distinct().Count();
    decimal avgPrice = totalItems > 0 ? Model.Average(d => d.Gia) : 0;
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid px-0 mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h2 class="text-label fw-bold mb-1 text-uppercase"><i class="bi bi-box-seam text-primary me-2"></i> Quản Lý Dịch Vụ</h2>
            <p class="text-muted small mb-0">Quản lý các sản phẩm, bắp, nước chung của toàn hệ thống rạp.</p>
        </div>
        <div>
            <a asp-action="Them" class="btn btn-primary shadow fw-bold px-4 py-2 text-uppercase rounded-pill">
                <i class="bi bi-plus-circle me-2"></i> Thêm Dịch Vụ
            </a>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3"><i class="bi bi-boxes text-primary fs-3"></i></div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Tổng sản phẩm</p>
                        <h3 class="mb-0 fw-bold">@totalItems</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3"><i class="bi bi-tags text-success fs-3"></i></div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Phân loại</p>
                        <h3 class="mb-0 fw-bold text-success">@totalCategories</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-warning h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3"><i class="bi bi-cash-coin text-warning fs-3"></i></div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Giá trung bình</p>
                        <h3 class="mb-0 fw-bold text-warning">@avgPrice.ToString("N0") đ</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center bg-light rounded-3">
            <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-list-task me-2"></i>Danh sách dịch vụ</h6>
            <div class="input-group" style="width: 350px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm tên dịch vụ, loại...">
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 px-4 text-start" style="width: 40%;">Thông tin Dịch vụ</th>
                        <th class="py-3 px-4 text-center" style="width: 15%;">Loại</th>
                        <th class="py-3 px-4 text-end" style="width: 20%;">Đơn giá</th>
                        <th class="py-3 px-4 text-end" style="width: 25%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center py-5 text-muted">Danh mục hiện đang trống!</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        string imgUrl = string.IsNullOrEmpty(item.HinhAnh) ? "/images/default-service.png" : $"/images/dichvu/{item.HinhAnh}";
                        <tr class="service-row">
                            <td class="px-4 py-3 text-start">
                                <div class="d-flex align-items-center">
                                    <img src="@imgUrl" class="rounded shadow-sm me-3 border" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.src='/images/default-service.png'" />
                                    <div>
                                        <strong class="d-block text-dark fs-6 service-name">@item.TenDv</strong>
                                        <span class="small text-muted">Mã: DV-@item.MaDv</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 text-center">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 service-category">
                                    @(string.IsNullOrEmpty(item.LoaiDv) ? "Khác" : item.LoaiDv)
                                </span>
                            </td>
                            <td class="px-4 text-end fw-bold text-danger fs-5">@item.Gia.ToString("N0") đ</td>
                            <td class="px-4 text-end">
                                <a asp-action="Sua" asp-route-id="@item.MaDv" class="btn btn-sm btn-outline-primary fw-bold me-2 shadow-sm px-3">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <form asp-action="Xoa" asp-route-id="@item.MaDv" method="post" class="d-inline">
                                    <button type="button" class="btn btn-sm btn-danger fw-bold shadow-sm px-3" onclick="xacNhanXoa(this)">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function forceHidePreloader() {
    const loader = document.getElementById('preloader') ||
    document.querySelector('.preloader') ||
    document.querySelector('.spinner-wrapper');
    if (loader) {
    loader.style.display = 'none';
    loader.style.opacity = '0';
    }
    document.body.style.overflow = 'auto';
    }

    document.addEventListener("DOMContentLoaded", function () {
    forceHidePreloader();
    var successMsg = @Html.Raw(Json.Serialize(TempData["Success"]));
    var errorMsg = @Html.Raw(Json.Serialize(TempData["Error"]));

    if (successMsg) {
    Swal.fire({
    toast: true,
    position: 'top-end',
    icon: 'success',
    title: successMsg,
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true
    });
    }

    if (errorMsg) {
    Swal.fire({
    icon: 'error',
    title: 'Thất bại!',
    text: errorMsg,
    confirmButtonColor: '#dc3545'
    });
    }
    });

    const searchInput = document.getElementById('searchInput');
    if(searchInput) {
    searchInput.addEventListener('keyup', function (e) {
    let term = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.service-row').forEach(row => {
    let name = row.querySelector('.service-name').textContent.toLowerCase();
    let cat = row.querySelector('.service-category').textContent.toLowerCase();
    row.style.display = (name.includes(term) || cat.includes(term)) ? '' : 'none';
    });
    });
    }

    function xacNhanXoa(btn) {
    Swal.fire({
    title: 'BẠN CÓ CHẮC CHẮN?',
    text: "Dữ liệu này sẽ bị xóa và không thể khôi phục!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc3545',
    cancelButtonColor: '#6c757d',
    confirmButtonText: 'Vâng, Xóa ngay!',
    cancelButtonText: 'Hủy'
    }).then((result) => {
    if (result.isConfirmed) {
    btn.closest('form').submit();
    }
    });
    }
</script>