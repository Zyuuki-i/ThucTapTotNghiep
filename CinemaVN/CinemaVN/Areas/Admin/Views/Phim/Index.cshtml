@model IEnumerable<CinemaVN.DatModels.CPhim>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-label fw-bold text-uppercase">
    <i class="bi bi-people "></i> Quản Lý Phim
</h2>

<div class="w-100 d-flex justify-content-between">
    <a asp-action="them" class="btn btn-primary shadow fw-bold px-4 py-2 text-uppercase">
        <i class="bi bi-plus-circle me-2"></i>Thêm Mới
    </a>
    <div class="d-flex justify-content-between">
        <form class="d-flex search-group me-1" method="get" asp-action="Index">
            <div class="input-group">
                <input class="form-control" type="search" name="keyword" placeholder="Tìm mã, tên phim" value="@ViewBag.Keyword" aria-label="Search">
                <input type="hidden" name="trangthai" value="@(ViewBag.TrangThai.ToString().ToLower())" />
                <button class="btn btn-search bg-black text-white" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
        @if (ViewBag.keyword != null && ViewBag.keyword != "")
        {
            <a asp-action="Index" class="btn btn-outline-info me-1">Quay lại</a>
        }
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">

            <select name="trangthai" class="form-select w-auto" onchange="this.form.submit()">
                <option value="-1">Tất cả</option>
                @{
                    var trangThai = ViewBag.TrangThai?.ToString();
                }
                <option value="0" selected="@(trangThai == "0" ? "selected" : null)">
                    Sắp chiếu
                </option>
                <option value="1" selected="@(trangThai == "1" ? "selected" : null)">
                    Đang chiếu
                </option>
                <option value="2" selected="@(trangThai == "2" ? "selected" : null)">
                    Ngừng chiếu
                </option>
            </select>
        </form>
    </div>
</div>
<div class="my-3">
    @if (TempData["MessageError_Phim"] != null)
    {
        <div class="alert alert-danger text-center fw-bold">
            @TempData["MessageError_Phim"]
        </div>
    }
    @if (TempData["MessageSuccess_Phim"] != null)
    {
        <div class="alert alert-success text-center fw-bold">
            @TempData["MessageSuccess_Phim"]
        </div>
    }
</div>
<div class="mt-3">
    <table class="table table-bordered text-center align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Poster)</th>
                <th>@Html.DisplayNameFor(model => model.TenPhim)</th>
                <th>@Html.DisplayNameFor(model => model.DaoDien)</th>
                <th>@Html.DisplayNameFor(model => model.NgayChieu)</th>
                <th>@Html.DisplayNameFor(model => model.ThoiLuong)</th>
                <th>@Html.DisplayNameFor(model => model.TrangThai)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count() > 0)
            {
                @foreach (var item in Model)
                {
                    <tr class="align-content-center">
                        <td style="width: 100px; height:150px">
                            @{
                                var hinh = item.Poster ?? "default.png";
                                var link = "~/images/posters/" + hinh;
                            }
                            <img src="@Url.Content(link)" alt="@(item.TenPhim)" style="object-fit: cover; width: 100px; height: 150px;" />
                        </td>
                        <td class="fw-bold" style="min-width:333px; max-width: 333px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @Html.DisplayFor(modelItem => item.TenPhim)
                        </td>
                        <td style="width:100px">
                            @Html.DisplayFor(modelItem => item.DaoDien)
                        </td>
                        <td>
                            @item.NgayChieu?.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ThoiLuong) phút
                        </td>
                        <td style="min-width:120px;">
                            <form asp-action="doiTrangThai" method="post">
                                <input type="hidden" name="id" value="@item.MaPhim" />

                                <select name="trangthai"
                                    class="form-select form-select-sm text-white
                                    @(item.TrangThai == 0 ? "bg-secondary" :
                                              item.TrangThai == 1 ? "bg-success" :
                                              "bg-danger")"
                                     onchange="this.form.submit()">

                                    <option value="0" selected="@(item.TrangThai == 0)">Sắp chiếu</option>
                                    <option value="1" selected="@(item.TrangThai == 1)">Đang chiếu</option>
                                    <option value="2" selected="@(item.TrangThai == 2)">Ngừng chiếu</option>

                                </select>
                            </form>
                        </td>
                        <td>
                            <a asp-action="xoa" asp-route-id="@item.MaPhim" class="btn btn-danger" onclick="return confirm('Hành động này sẽ xóa bỏ hoàn toàn phim @(item.MaPhim)! Bạn có chắc chắn muốn tiếp tục?');">Xóa</a>
                            <a asp-action="sua" asp-route-id="@item.MaPhim" class="btn btn-primary">Sửa</a>
                            <a asp-action="chiTiet" asp-route-id="@item.MaPhim" class="btn btn-info">Chi tiết</a>
                        </td>
                    </tr>
                }
                <tr>
                    @if(ViewBag.tongTrang != null && ViewBag.tongTrang > 1)
                    {
                    <td colspan="9">
                        <div class="d-flex justify-content-center mt-3">
                            @{
                                int trangHT = ViewBag.trangHT ?? 1;
                                int tongTrang = ViewBag.tongTrang ?? 1;
                                string? keyword = ViewBag.Keyword as string;
                                int trangthai = ViewBag.TrangThai ?? -1;
                            }
                            @if (tongTrang > 1)
                            {
                                <ul class="pagination">

                                    <!-- Prev -->
                                    <li class="page-item @(trangHT == 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-keyword="@keyword"
                                           asp-route-trangthai="@trangthai"
                                           asp-route-trang="1">«</a>
                                    </li>

                                    <!-- Pages -->
                                    @for (int i = 1; i <= tongTrang; i++)
                                    {
                                        <li class="page-item @(i == trangHT ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-keyword="@keyword"
                                               asp-route-trangthai="@trangthai"
                                               asp-route-trang="@i">@i</a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(trangHT == tongTrang ? "disabled" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-keyword="@keyword"
                                           asp-route-trangthai="@trangthai"
                                           asp-route-trang="@(tongTrang)">»</a>
                                    </li>
                                </ul>
                            }
                        </div>
                    </td>
                    }
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center text-secondary">
                        @{
                            int trangthai = ViewBag.TrangThai as int? ?? -1;
                        }

                        @(trangthai switch
                        {
                            0 => "Không có phim sắp chiếu",
                            1 => "Không có phim đang chiếu",
                            2 => "Không có phim ngừng chiếu",
                            _ => "Không có phim"
                        }),
                        <a asp-action="Index" class="text-decoration-none">quay lại</a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const alertBox = document.querySelector(".alert");
        if (alertBox) {
            setTimeout(() => alertBox.style.display = "none", 10000);
        }
    });
</script>