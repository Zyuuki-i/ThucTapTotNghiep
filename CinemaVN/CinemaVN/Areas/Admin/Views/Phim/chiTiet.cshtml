@model CinemaVN.DatModels.CPhim

@{
    ViewData["Title"] = "chiTiet";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string? theLoais = ViewBag.TheLoais as string;
}

<h1 class="text-label text-center">QUẢN LÝ PHIM</h1>
<div class="row mb-2">
    <div class="col-5"><hr /></div>
    <div class="col-2 text-center">
        <h3 class="text-info">CHI TIẾT</h3>
    </div>
    <div class="col-5"><hr /></div>
    <div class="col-12 text-center">
        <a class="btn btn-outline-info w-25" asp-action="Index">Quay lại</a>
    </div>
</div>
@if(Model != null)
{
    <div class="row g-3 px-2 justify-content-between align-content-center">
        <div class="col col-3 border border-3 border-info rounded shadow text-center align-content-center py-4">
            @{
                var anh = Model.Poster != null ? Model.Poster : "default.png";
                var linkAnh = Url.Content("~/images/poster/" + anh);
            }
            <img src="@Url.Content(linkAnh)" alt="@Model.MaPhim Image" class="img-fluid">
            <a class="btn btn-outline-danger mt-3" asp-action="xoaAnh" asp-route-id="@Model.MaPhim">Xóa ảnh</a>
        </div>
        <div class="col col-9 border border-3 border-info rounded shadow py-2 ps-5 align-content-center">
            <dl class="row mb-0">
                <dt class="col-sm-3">Mã Phim</dt>
                <dd class="col-sm-9">@Model.MaPhim</dd>
                <dt class="col-sm-3">Tên Phim</dt>
                <dd class="col-sm-9">
                    @Model.TenPhim
                    @if (Model.DoTuoi == 0)
                    {
                        <span class="rounded-2 p-2 text-white bg-success">P</span>
                    }
                    else if (Model.DoTuoi >= 13 && Model.DoTuoi < 16)
                    {
                        <span class="rounded-2 p-2 text-white bg-info">T13</span>
                    }
                    else if (Model.DoTuoi >= 16 && Model.DoTuoi < 18)
                    {
                        <span class="rounded-2 p-2 text-white bg-warning">T16</span>
                    }
                    else if (Model.DoTuoi >= 18)
                    {
                        <span class="rounded-2 p-2 text-white bg-danger">T18</span>
                    }
                    else
                    {
                        <span class="rounded-2 p-2 text-white bg-danger">C</span>
                    }
                </dd>
                <dt class="col-sm-3">Thể Loại</dt>
                <dd class="col-sm-9">@(theLoais ?? "Chưa rõ")</dd>
                <dt class="col-sm-3">Đạo Diễn</dt>
                <dd class="col-sm-9">@Model.DaoDien</dd>
                <dt class="col-sm-3">Ngày Công Chiếu</dt>
                <dd class="col-sm-9">@Model.NgayChieu?.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-3">Thời Lượng</dt>
                <dd class="col-sm-9">@Model.ThoiLuong phút</dd>
                <dt class="col-sm-3">Trailer</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(@Model.Trailer) &&
                                    (@Model.Trailer.Contains("youtube") || @Model.Trailer.Contains("youtu.be")))
                    {
                        var id = GetYoutubeId(@Model.Trailer);

                        if (!string.IsNullOrEmpty(id))
                        {
                            <iframe width="300" height="180"
                                    src="https://www.youtube.com/embed/@id"
                                    frameborder="0"
                                    allowfullscreen>
                            </iframe>
                        }
                        else
                        {
                            <span class="text-muted">Không có trailer</span>
                        }
                    }
                    else if (!string.IsNullOrEmpty(@Model.Trailer))
                    {
                        <video width="300" height="180" controls>
                            <source src="~/videos/@Model.Trailer" type="video/mp4">
                        </video>
                    }else
                    {
                        <span class="text-muted">Không có trailer</span>
                    }
                </dd>
                <dt class="col-sm-3">Trạng Thái</dt>
                <dd class="col-sm-9 mt-2">
                    @if (Model.TrangThai == 0)
                    {
                        <span class="rounded-2 p-2 text-white bg-secondary">Sắp chiếu</span>
                    }
                    else if (Model.TrangThai == 1)
                    {
                        <span class="rounded-2 p-2 text-white bg-success">Đang chiếu</span>
                    }
                    else if (Model.TrangThai == 2)
                    {
                        <span class="rounded-2 p-2 text-white bg-danger">Ngừng chiếu</span>
                    }
                    else
                    {
                        <span class="rounded-2 p-2 text-white bg-secondary">Không xác định</span>
                    }
                </dd>
                <dt class="col-sm-10"></dt>
            </dl>
        </div>
        <div class="col col-12 border border-3 border-info rounded shadow text-center py-2">
            <p>
                <strong>MÔ TẢ</strong>
            </p>
            <p class="text-muted">@Model.MoTa</p>
        </div>
    </div>
}

@functions {
    public string GetYoutubeId(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "";

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return "";

        if (uri.Host.Contains("youtu.be"))
            return uri.AbsolutePath.Trim('/');

        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query["v"] ?? "";
    }
}

