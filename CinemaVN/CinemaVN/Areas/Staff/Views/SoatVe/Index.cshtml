@{
    ViewData["Title"] = "Kiểm Soát Vé Vào Rạp";
    Layout = "~/Areas/Staff/Views/Shared/_StaffLayout.cshtml";
}

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid py-3" style="background-color: #f2f2f2; min-height: 90vh;">
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-5 border-primary">
        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-qr-code-scan text-primary me-2"></i>HỆ THỐNG SOÁT VÉ ĐIỆN TỬ</h4>
        <div>
            <span class="badge bg-danger fs-6 me-2"><i class="bi bi-person-badge"></i> @ViewBag.TenNhanVien</span>
            <span class="badge bg-dark fs-6"><i class="bi bi-geo-alt-fill"></i> @ViewBag.TenChiNhanh</span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-dark text-white text-center py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-camera-video me-2"></i>QUÉT MÃ QR HOẶC BARCODE</h5>
                </div>
                <div class="card-body p-4 text-center">
                    
                    <div id="reader" class="w-100 rounded overflow-hidden shadow-sm mb-4 border border-3 border-dark" style="background: #000; min-height: 350px;"></div>
                    
                    <div class="d-flex gap-2 justify-content-center mb-4">
                        <button class="btn btn-success fw-bold" onclick="startCamera()"><i class="bi bi-play-circle me-1"></i> Bật Camera</button>
                        <button class="btn btn-danger fw-bold" onclick="stopCamera()"><i class="bi bi-stop-circle me-1"></i> Tắt Camera</button>
                    </div>

                    <hr class="text-muted" />

                    <div class="text-start mt-3">
                        <label class="fw-bold small text-muted mb-2">NHẬP MÃ THỦ CÔNG</label>
                        <div class="input-group">
                            <input type="text" id="manualInput" class="form-control form-control-lg fw-bold text-center" placeholder="Nhập mã hóa đơn" autocomplete="off">
                            <button class="btn btn-primary fw-bold px-4" onclick="guiMaVeTrucTiep()"><i class="bi bi-arrow-right-circle fs-5"></i></button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white" id="resultCard">
                <div class="card-header bg-secondary text-white text-center py-3 rounded-top-4" id="resultHeader">
                    <h5 class="mb-0 fw-bold">KẾT QUẢ KIỂM TRA</h5>
                </div>
                
                <div id="waitingScreen" class="card-body d-flex flex-column align-items-center justify-content-center py-5">
                    <i class="bi bi-qr-code text-muted opacity-25" style="font-size: 8rem;"></i>
                    <h4 class="text-muted mt-3">Chờ quét mã vé...</h4>
                </div>

                <div id="dataScreen" class="card-body p-4 p-md-5 d-none">
                    
                    <div class="text-center mb-4" id="statusIcon">
                    </div>

                    <h2 class="text-center fw-bold mb-4" id="resMessage">THÀNH CÔNG</h2>

                    <div class="bg-light p-4 rounded-4 border border-2" id="resBox">
                        <div class="mb-3">
                            <small class="text-muted d-block fw-bold mb-1">TÊN PHIM</small>
                            <h4 class="fw-bold text-dark mb-0" id="resPhim">---</h4>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block fw-bold mb-1">SUẤT CHIẾU</small>
                                <h5 class="fw-bold text-primary mb-0" id="resSuat">--:--</h5>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block fw-bold mb-1">PHÒNG CHIẾU</small>
                                <h5 class="fw-bold text-dark mb-0" id="resRap">---</h5>
                            </div>
                        </div>

                        <div class="mb-3 p-3 bg-white border rounded border-warning border-2">
                            <small class="text-muted d-block fw-bold mb-1">SỐ LƯỢNG: <span id="resSoVe">0</span> VÉ</small>
                            <h3 class="fw-bold text-danger mb-0" id="resGhe">---</h3>
                        </div>

                        <div>
                            <small class="text-muted d-block fw-bold mb-1">KHÁCH HÀNG</small>
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-person-fill me-1"></i><span id="resKhach">---</span></h6>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    let html5QrcodeScanner = null;
    let isProcessing = false; // Khóa chống quét liên tục (spam)

    // Khởi tạo Camera
    function startCamera() {
    if(html5QrcodeScanner == null) {
    html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: {width: 250, height: 250} }, false);
    }
    html5QrcodeScanner.render(onScanSuccess, onScanFailure);
    }

    function stopCamera() {
    if (html5QrcodeScanner) {
    html5QrcodeScanner.clear();
    }
    }

    // Khi quét Camera thành công
    function onScanSuccess(decodedText, decodedResult) {
    if(isProcessing) return; // Nếu đang xử lý mã trước thì bỏ qua
        
    isProcessing = true; // Khóa lại
    document.getElementById('manualInput').value = decodedText;
    guiLenServer(decodedText);
        
    // Dừng camera 3 giây để chống quét lặp lại 1 mã n lần
    setTimeout(() => { isProcessing = false; }, 3000);
    }

    function onScanFailure(error) { /* Không làm gì khi đang dò tìm mã */ }

    // Xử lý khi quét bằng súng USB (Súng quét xong sẽ tự gõ Enter)
    document.getElementById('manualInput').addEventListener('keypress', function (e) {
    if (e.key === 'Enter') {
    guiMaVeTrucTiep();
    }
    });

    function guiMaVeTrucTiep() {
    let txt = document.getElementById('manualInput').value.trim();
    if(txt !== '') guiLenServer(txt);
    }

    // ===============================================
    // HÀM GỬI LÊN SERVER KIỂM TRA
    // ===============================================
    function guiLenServer(qrCodeStr) {
    // Đổi giao diện sang trạng thái Loading
    document.getElementById('waitingScreen').classList.add('d-none');
    document.getElementById('dataScreen').classList.remove('d-none');
    document.getElementById('statusIcon').innerHTML = '<div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status"></div>';
    document.getElementById('resMessage').innerText = 'ĐANG KIỂM TRA...';
    document.getElementById('resMessage').className = 'text-center fw-bold mb-4 text-primary';
    document.getElementById('resBox').style.opacity = '0.3'; // Làm mờ dữ liệu cũ

    fetch(`/Staff/SoatVe/KiemTraVe`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ QrCode: qrCodeStr })
    })
    .then(res => res.json())
    .then(data => {
    document.getElementById('resBox').style.opacity = '1';
            
    let header = document.getElementById('resultHeader');
    let icon = document.getElementById('statusIcon');
    let msg = document.getElementById('resMessage');
    let box = document.getElementById('resBox');

    if(data.success) {
    // HỢP LỆ VÀ CẬP NHẬT TRẠNG THÁI THÀNH CÔNG
    header.className = 'card-header bg-success text-white text-center py-3 rounded-top-4';
    icon.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>';
    msg.innerText = 'SOÁT VÉ THÀNH CÔNG';
    msg.className = 'text-center fw-bold mb-4 text-success';
    box.className = 'bg-success bg-opacity-10 p-4 rounded-4 border border-2 border-success';
                
    // Đổ dữ liệu
    document.getElementById('resPhim').innerText = data.phim;
    document.getElementById('resSuat').innerText = data.suat;
    document.getElementById('resRap').innerText = data.rap;
    document.getElementById('resGhe').innerText = data.ghe;
    document.getElementById('resSoVe').innerText = data.soVe;
    document.getElementById('resKhach').innerText = data.khach;

    // Tự động xóa input để quét tiếp
    document.getElementById('manualInput').value = '';
    document.getElementById('manualInput').focus();

    } else {
    // VÉ LỖI HOẶC ĐÃ SOÁT
    header.className = 'card-header bg-danger text-white text-center py-3 rounded-top-4';
    icon.innerHTML = '<i class="bi bi-x-octagon-fill text-danger" style="font-size: 5rem;"></i>';
    msg.innerText = data.message.toUpperCase();
    msg.className = 'text-center fw-bold mb-4 text-danger fs-5';
    box.className = 'bg-danger bg-opacity-10 p-4 rounded-4 border border-2 border-danger';
                
    // Đổ tên phim nếu có
    document.getElementById('resPhim').innerText = data.phim || '---';
    document.getElementById('resSuat').innerText = '--:--';
    document.getElementById('resRap').innerText = '---';
    document.getElementById('resGhe').innerText = '---';
    document.getElementById('resSoVe').innerText = '0';
    document.getElementById('resKhach').innerText = '---';

    document.getElementById('manualInput').value = '';
    document.getElementById('manualInput').focus();
    }
    })
    .catch(err => {
    Swal.fire('Lỗi', 'Mất kết nối đến máy chủ!', 'error');
    });
    }

    // Bật focus vào ô nhập liệu khi vừa load trang để ưu tiên quét súng
    document.addEventListener("DOMContentLoaded", function() {
    document.getElementById('manualInput').focus();
    });
</script>