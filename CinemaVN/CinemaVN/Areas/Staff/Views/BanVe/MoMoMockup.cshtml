@{
    // Bỏ layout mặc định để trang giống một cổng thanh toán độc lập của bên thứ 3
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cổng Thanh Toán MoMo (Giả lập)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
        background-color: #f4f4f4;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        }

        .momo-container {
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        text-align: center;
        max-width: 450px;
        width: 100%;
        border-top: 10px solid #ae2070;
        }

        .momo-logo {
        width: 80px;
        margin-bottom: 20px;
        }

        .qr-placeholder {
        width: 250px;
        height: 250px;
        margin: 20px auto;
        border: 2px dashed #ae2070;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fdf0f7;
        border-radius: 10px;
        }

        .qr-placeholder img {
        width: 200px;
        }

        .btn-momo {
        background-color: #ae2070;
        color: white;
        font-weight: bold;
        padding: 12px 20px;
        border-radius: 8px;
        border: none;
        width: 100%;
        transition: 0.3s;
        }

        .btn-momo:hover {
        background-color: #8c1959;
        color: white;
        }
    </style>
</head>
<body>

    <div class="momo-container">
        <img src="https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png" alt="MoMo Logo" class="momo-logo" />
        <h4 class="mb-3">Thanh toán vé xem phim</h4>

        <div class="text-start mb-3">
            <p class="mb-1 text-muted">Mã đơn hàng:</p>
            <h5 id="lblOrderId" class="text-danger">@ViewBag.OrderId</h5>
        </div>

        <div class="qr-placeholder">
            <img src="https://upload.wikimedia.org/wikipedia/commons/d/d0/QR_code_for_mobile_English_Wikipedia.svg" alt="QR Code" />
        </div>


        <button id="btnThanhToanXong" class="btn btn-momo mt-2">
            Mô phỏng: Khách đã thanh toán thành công
        </button>

        <button id="btnHuy" class="btn btn-outline-secondary w-100 mt-2">
            Hủy giao dịch
        </button>
    </div>

    <script>
        // Xử lý khi nhấn nút "Mô phỏng thanh toán"
        document.getElementById('btnThanhToanXong').addEventListener('click', function () {
        let orderId = document.getElementById('lblOrderId').innerText;

        Swal.fire({
        title: 'Đang xử lý giao dịch...',
        allowOutsideClick: false,
        didOpen: () => {
        Swal.showLoading();
        }
        });

        // GỌI NGẦM VỀ HÀM IPN ĐỂ ĐỔI TRẠNG THÁI HÓA ĐƠN TRONG DATABASE
        fetch('/Staff/BanVe/SaveMoMoPayment', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json'
        },
        body: JSON.stringify({
        orderId: orderId,
        resultCode: 0 // resultCode = 0 có nghĩa là giao dịch thành công theo chuẩn MoMo
        })
        })
        .then(response => {
        if (response.ok) {
        Swal.fire({
        icon: 'success',
        title: 'Giao dịch thành công!',
        text: 'Hóa đơn và Vé đã được chuyển sang trạng thái Đã Thanh Toán.',
        confirmButtonColor: '#ae2070'
        }).then((result) => {
        // Thanh toán xong thì quay trở lại trang bán vé của Staff
        window.location.href = '/Staff/BanVe/Index';
        });
        } else {
        Swal.fire('Lỗi', 'Không thể cập nhật trạng thái hóa đơn', 'error');
        }
        })
        .catch(error => {
        Swal.fire('Lỗi', 'Mất kết nối đến Server', 'error');
        });
        });

        // Nút hủy: Trở về trang bán vé mà không làm gì cả (Trạng thái hóa đơn vẫn là 0)
        document.getElementById('btnHuy').addEventListener('click', function () {
        window.location.href = '/Staff/BanVe/Index';
        });
    </script>
</body>
</html>