@{
    ViewData["Title"] = "Trung Tâm Hỗ Trợ Khách Hàng";
    Layout = "~/Areas/Staff/Views/Shared/_StaffLayout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-5">
        <h2 class="fw-bold text-uppercase text-dark mb-1">
            <i class="bi bi-headset text-danger me-2"></i> TRUNG TÂM HỖ TRỢ
        </h2>
        <p class="text-muted">Vui lòng chọn nghiệp vụ cần xử lý cho khách hàng bên dưới.</p>
    </div>

    <div class="row g-4">
        
        <div class="col-md-4">
            <a asp-area="Staff" asp-controller="HoTroKhachHang" asp-action="HoanVe" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm card-hover-danger rounded-4 transition-all">
                    <div class="card-body p-5 text-center">
                        <div class="icon-circle bg-danger bg-opacity-10 text-danger mx-auto mb-4">
                            <i class="bi bi-arrow-counterclockwise fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-3">XỬ LÝ HOÀN VÉ</h4>
                        <p class="text-muted mb-0">Tiếp nhận và gửi yêu cầu hoàn tiền vé cho khách hàng (Tuân thủ chính sách rạp).</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <span class="btn btn-outline-danger rounded-pill px-4 fw-bold">Bắt đầu xử lý</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a href="#" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm card-hover-primary rounded-4 transition-all">
                    <div class="card-body p-5 text-center">
                        <div class="icon-circle bg-primary bg-opacity-10 text-primary mx-auto mb-4">
                            <i class="bi bi-arrow-left-right fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-3">ĐỔI VÉ / SUẤT</h4>
                        <p class="text-muted mb-0">Hỗ trợ khách hàng thay đổi ghế ngồi hoặc suất chiếu khác (Nếu còn chỗ).</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <span class="btn btn-outline-primary rounded-pill px-4 fw-bold">Xem chi tiết</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a href="#" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm card-hover-dark rounded-4 transition-all">
                    <div class="card-body p-5 text-center">
                        <div class="icon-circle bg-dark bg-opacity-10 text-dark mx-auto mb-4">
                            <i class="bi bi-chat-dots fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-3">GỬI PHẢN HỒI</h4>
                        <p class="text-muted mb-0">Ghi nhận thông tin khiếu nại, góp ý về dịch vụ của chi nhánh lên hệ thống.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <span class="btn btn-outline-dark rounded-pill px-4 fw-bold">Gửi yêu cầu</span>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .icon-circle {
        width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
    .card-hover-danger:hover {
        transform: translateY(-10px);
        background-color: #fff5f5;
        box-shadow: 0 15px 30px rgba(220, 53, 69, 0.15) !important;
    }
    .card-hover-primary:hover {
        transform: translateY(-10px);
        background-color: #f0f7ff;
        box-shadow: 0 15px 30px rgba(13, 110, 253, 0.15) !important;
    }
    .card-hover-dark:hover {
        transform: translateY(-10px);
        background-color: #f8f9fa;
        box-shadow: 0 15px 30px rgba(33, 37, 41, 0.15) !important;
    }

    .letter-spacing {
        letter-spacing: 1px;
    }
</style>