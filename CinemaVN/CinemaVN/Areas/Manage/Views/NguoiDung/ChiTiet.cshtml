@model CinemaVN.Models.NguoiDung
@{
    ViewData["Title"] = "Chi Tiết Hồ Sơ Nhân Viên";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
    
    // Xử lý hiển thị ảnh mặc định nếu nhân viên chưa có ảnh
    string avatarUrl = string.IsNullOrEmpty(Model.Hinh)
        ? $"https://ui-avatars.com/api/?name={Model.HoTen}&background=0D8ABC&color=fff&size=150"
        : $"/images/avatars/{Model.Hinh}";
}

<div class="container mt-4" style="max-width: 1000px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-label text-uppercase mb-0 fw-bold">
            <i class="bi bi-person-lines-fill text-primary me-2"></i>HỒ SƠ NHÂN SỰ
        </h2>
        <div>
            <a asp-action="Sua" asp-route-id="@Model.MaNd" class="btn btn-warning shadow-sm fw-bold me-2">
                <i class="bi bi-pencil-square"></i> Cập nhật
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm fw-bold">
                <i class="bi bi-arrow-left"></i> Trở về
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: AVATAR VÀ THÔNG TIN CƠ BẢN -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 text-center overflow-hidden h-100">
                <div class="bg-dark" style="height: 100px;"></div> <!-- Ảnh bìa mini -->
                <div class="card-body pb-5 mt-n5">
                    <!-- Avatar -->
                    <img src="@avatarUrl" class="rounded-circle shadow-lg border border-5 border-white mb-3" style="width: 150px; height: 150px; object-fit: cover; margin-top: -75px;" alt="Avatar" />
                    
                    <h4 class="fw-bold mb-1">@Model.HoTen</h4>
                    <p class=" mb-3"><i class="bi bi-person-workspace me-1"></i>@(string.IsNullOrEmpty(Model.ChucVu) ? "Staff" : Model.ChucVu)</p>
                    
                    <div class="d-flex justify-content-center gap-2 mb-2">
                        @if (Model.TrangThai == true)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill">
                                <i class="bi bi-lock-fill me-1"></i> Tài khoản bị khóa
                            </span>
                        }
                       
                    </div>
                    <div>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill">
                            <i class="bi bi-geo-alt-fill me-1"></i> @Model.MaCnNavigation?.TenCn
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CHI TIẾT THÔNG TIN -->
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-info-circle text-info me-2"></i>Thông tin chi tiết</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Thông tin cá nhân -->
                        <div class="col-sm-6">
                            <p class="text-muted small mb-1 fw-bold text-uppercase">Tài khoản đăng nhập (Email)</p>
                            <div class="d-flex align-items-center">
                                <div class="bg-light p-2 rounded me-2 text-primary"><i class="bi bi-envelope-fill"></i></div>
                                <h6 class="mb-0 fw-bold">@Model.Email</h6>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <p class="text-muted small mb-1 fw-bold text-uppercase">Số điện thoại</p>
                            <div class="d-flex align-items-center">
                                <div class="bg-light p-2 rounded me-2 text-success"><i class="bi bi-telephone-fill"></i></div>
                                <h6 class="mb-0 fw-bold">@Model.Sdt</h6>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <p class="text-muted small mb-1 fw-bold text-uppercase">Căn cước công dân</p>
                            <div class="d-flex align-items-center">
                                <div class="bg-light p-2 rounded me-2 text-warning"><i class="bi bi-credit-card-2-front-fill"></i></div>
                                <h6 class="mb-0 fw-bold">@Model.Cccd</h6>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <p class="text-muted small mb-1 fw-bold text-uppercase">Giới tính & Ngày sinh</p>
                            <div class="d-flex align-items-center">
                                <div class="bg-light p-2 rounded me-2 text-danger"><i class="bi bi-calendar-event-fill"></i></div>
                                <h6 class="mb-0 fw-bold">
                                    @(Model.Phai == true ? "Nam" : "Nữ") &bull; @(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                                </h6>
                            </div>
                        </div>

                        <div class="col-12">
                            <p class="text-muted small mb-1 fw-bold text-uppercase">Địa chỉ thường trú</p>
                            <div class="d-flex align-items-center bg-light p-3 rounded-3 border">
                                <i class="bi bi-house-door-fill text-secondary fs-4 me-3"></i>
                                <h6 class="mb-0">@Model.DiaChi</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>