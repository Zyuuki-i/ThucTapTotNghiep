@model CinemaVN.Models.NguoiDung
@{
    ViewData["Title"] = "Cập Nhật Hồ Sơ";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
    string avatarUrl = string.IsNullOrEmpty(Model.Hinh)
        ? $"https://ui-avatars.com/api/?name={Model.HoTen}&background=e9ecef&color=6c757d&size=150"
        : $"/images/avatars/{Model.Hinh}";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-label text-uppercase mb-0 fw-bold">
            <i class="bi bi-pencil-square text-warning me-2"></i>CẬP NHẬT HỒ SƠ
        </h2>
        <div>
            <a asp-action="ChiTiet" asp-route-id="@Model.MaNd" class="btn btn-outline-info shadow-sm fw-bold me-2">
                <i class="bi bi-eye"></i> Xem chi tiết
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm fw-bold">
                <i class="bi bi-arrow-left"></i> Danh sách
            </a>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-dark text-white fw-bold py-3 d-flex align-items-center">
            <i class="bi bi-person-lines-fill fs-5 me-2 text-warning"></i> Chỉnh sửa thông tin nhân sự
        </div>
        <div class="card-body p-4 p-md-5 bg-light">
            
            <form asp-action="Sua" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="MaNd" />
                <div class="col-md-12 mb-5 text-center">
                    <div class="position-relative d-inline-block">
                        <img id="avatarPreview" src="@avatarUrl"
                             class="rounded-circle shadow border border-4 border-white"
                             style="width: 140px; height: 140px; object-fit: cover;" alt="Avatar" />
                        
                        <label for="HinhAnhMoi" class="position-absolute bottom-0 end-0 bg-warning text-dark rounded-circle shadow-sm"
                               style="cursor: pointer; padding: 10px; transform: translate(-10px, -10px);" title="Thay đổi ảnh">
                            <i class="bi bi-camera-fill fs-5"></i>
                        </label>
                        <input type="file" id="HinhAnhMoi" name="HinhAnhMoi" class="d-none" accept="image/*" onchange="previewImage(event)" />
                    </div>
                    <div class="small text-muted mt-2 fw-bold">Ảnh đại diện (Bỏ qua nếu giữ nguyên)</div>
                </div>
                <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                    <i class="bi bi-person-vcard text-primary me-2"></i>Hồ sơ nhân viên
                </h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control form-control-lg shadow-sm" required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Ngày sinh <span class="text-danger">*</span></label>
                        <input asp-for="NgaySinh" type="date" class="form-control form-control-lg shadow-sm text-center" required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Giới tính <span class="text-danger">*</span></label>
                        <select asp-for="Phai" class="form-select form-select-lg shadow-sm" required>
                            <option value="true">Nam</option>
                            <option value="false">Nữ</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Số Căn cước công dân <span class="text-danger">*</span></label>
                        <input asp-for="Cccd" class="form-control shadow-sm" maxlength="12" required pattern="[0-9]{12}" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="Sdt" class="form-control shadow-sm" required />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">Địa chỉ thường trú <span class="text-danger">*</span></label>
                        <input asp-for="DiaChi" class="form-control shadow-sm" required />
                    </div>
                </div>
                <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2 mt-4">
                    <i class="bi bi-briefcase-fill text-warning me-2"></i>Công việc & Hệ thống
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-primary">Vị trí công tác</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-workspace"></i></span>
                            <input asp-for="ChucVu" list="danhSachChucVu" class="form-control border-start-0" required />
                        </div>
                        <datalist id="danhSachChucVu">
                            <option value="NV Bán vé / Thanh toán"></option>
                            <option value="NV Soát vé"></option>
                            <option value="NV Chăm sóc khách hàng"></option>
                            <option value="NV Kỹ thuật phòng chiếu"></option>
                            <option value="NV Vệ sinh / Buồng phòng"></option>
                        </datalist>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Trạng thái hoạt động</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-power"></i></span>
                            <select asp-for="TrangThai" class="form-select border-start-0 text-dark fw-bold">
                                <option value="true">Đang hoạt động</option>
                                <option value="false">Khóa tài khoản</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Email đăng nhập</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control border-start-0" required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-danger">Đổi Mật khẩu (Tùy chọn)</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-key"></i></span>
                            <input name="MatKhauMoi" type="password" class="form-control border-start-0 border-warning" placeholder="Để trống nếu giữ nguyên" />
                        </div>
                        <small class="text-muted mt-1 d-block">Nhập mật khẩu mới nếu muốn đặt lại cho nhân viên này.</small>
                    </div>
                </div>

                <div class="mt-5 pt-4 text-end border-top">
                    <button type="submit" class="btn btn-warning px-5 py-2 fw-bold shadow-lg rounded-3">
                        <i class="bi bi-save-fill me-2"></i>LƯU THAY ĐỔI
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        var reader = new FileReader();
        reader.onload = function(){
            var output = document.getElementById('avatarPreview');
            output.src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
    }
</script>

