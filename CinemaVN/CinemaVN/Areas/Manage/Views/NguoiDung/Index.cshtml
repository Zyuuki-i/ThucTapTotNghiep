@model IEnumerable<CinemaVN.Models.NguoiDung>
@{
    ViewData["Title"] = "Quản lý Nhân sự";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
    
    int totalCount = Model.Count();
    int activeCount = Model.Count(n => n.TrangThai == true);
    int lockedCount = totalCount - activeCount;
}

<div class="container-fluid px-0 mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h2 class="text-label fw-bold mb-2"><i class="bi bi-people-fill text-primary me-2"></i> Quản Lý Nhân Viên Và Tài Khoản</h2>
            <span class="badge bg-dark text-white shadow-sm fs-6 fw-normal px-3 py-2">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Chi nhánh: <strong class="text-warning">@ViewBag.TenChiNhanh</strong>
            </span>
        </div>
        <a asp-action="Them" class="btn btn-primary shadow fw-bold px-4 py-2 text-uppercase">
            <i class="bi bi-person-plus-fill me-2"></i>Cấp tài khoản
        </a>
    </div>

    <!-- Mini Dashboard -->
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-people text-primary fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Tổng nhân sự</p>
                        <h3 class="mb-0 fw-bold">@totalCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-person-check text-success fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Đang hoạt động</p>
                        <h3 class="mb-0 fw-bold text-success">@activeCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-danger h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-person-lock text-danger fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Bị khóa</p>
                        <h3 class="mb-0 fw-bold text-danger">@lockedCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh công cụ thông minh -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center bg-light rounded-3">
            <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-list-task me-2"></i>Danh sách nhân viên</h6>
            <div class="input-group" style="width: 300px;">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm tên, SĐT, Email...">
            </div>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="employeeTable">
                <thead class="table-dark">
                    <tr>
                        <!-- Thêm tỷ lệ % width cố định và căn lề đồng bộ -->
                        <th class="py-3 px-4 text-start" style="width: 35%;">Hồ sơ Nhân viên</th>
                        <th class="text-start py-3 px-4" style="width: 20%;">Tài khoản đăng nhập</th>
                        <th class="text-center py-3 px-4" style="width: 15%;">Chức vụ</th>
                        <th class="text-center py-3 px-4" style="width: 15%;">Trạng thái</th>
                        <th class="text-end py-3 px-4" style="width: 15%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có dữ liệu nhân viên nào tại chi nhánh này.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <!-- Dòng dữ liệu -->
                        <tr class="employee-row position-relative" style="cursor: pointer;" onclick="goToDetail(event, '@Url.Action("ChiTiet", new { id = item.MaNd })')">
                            <td class="px-4 py-3 text-start">
                                <div class="d-flex align-items-center">
                                    @{
                                        string firstLetter = string.IsNullOrWhiteSpace(item.HoTen) ? "?" : item.HoTen.Trim().Substring(0, 1).ToUpper();
        
                                        // Giả sử tên cột ảnh của bạn là HinhAnh (thay đổi nếu cần)
                                        string imgUrl = string.IsNullOrEmpty(item.Hinh) ? "" : $"/images/avatars/{item.Hinh}";
                                    }

                                    @if (!string.IsNullOrEmpty(imgUrl))
                                    {
                                        <img src="@imgUrl" class="rounded-circle flex-shrink-0 me-3 shadow-sm border border-2 border-white" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" alt="Avatar" />
        
                                        <div class="bg-secondary bg-gradient text-white rounded-circle justify-content-center align-items-center flex-shrink-0 me-3 shadow-sm" style="width: 45px; height: 45px; display: none;">
                                            <span class="fw-bold fs-5">@firstLetter</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-secondary bg-gradient text-white rounded-circle d-flex justify-content-center align-items-center flex-shrink-0 me-3 shadow-sm" style="width: 45px; height: 45px;">
                                            <span class="fw-bold fs-5">@firstLetter</span>
                                        </div>
                                    }

                                    <div>
                                        <strong class="d-block text-dark employee-name">@item.HoTen</strong>
                                        <div class="small text-muted employee-contact mt-1">
                                            <span class="me-2"><i class="bi bi-telephone-fill"></i> @item.Sdt</span>
                                            <span><i class="bi bi-envelope-fill"></i> @item.Email</span>
                                        </div>
                                        @if (item.MaNd == ViewBag.CurrentUserId)
                                        {
                                            <span class="badge bg-primary mt-1" style="font-size: 0.65rem;">Hồ sơ của bạn</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-start">
                                <span class="badge bg-light text-dark border border-secondary px-2 py-1 employee-username">
                                    <i class="bi bi-person-badge me-1"></i> @item.Email
                                </span>
                            </td>
                            <!-- Căn giữa cột Chức vụ -->
                            <td class="text-center">
                                <span class="badge bg-info bg-opacity-75 text-info-emphasis border border-info px-2 py-1">@item.MaVtNavigation?.TenVt</span>
                            </td>
                            <!-- Căn giữa cột Trạng thái -->
                            <td class="text-center">
                                @if (item.TrangThai == true)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.4rem; vertical-align: middle;"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">
                                        <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                    </span>
                                }
                            </td>
                            <!-- Căn phải cột Thao tác -->
                            <td class="text-end px-4">
                                <a asp-action="Sua" asp-route-id="@item.MaNd" class="btn btn-sm btn-light border shadow-sm text-warning fw-bold me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            
                                @if (item.MaNd != ViewBag.CurrentUserId)
                                {
                                    @if (item.TrangThai == true)
                                    {
                                        <button type="button" class="btn btn-sm btn-light border shadow-sm text-danger fw-bold" title="Khóa tài khoản"
                                                onclick="openLockModal(@item.MaNd, '@item.HoTen')">
                                            <i class="bi bi-lock-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-light border shadow-sm text-success fw-bold" title="Mở khóa tài khoản"
                                                onclick="openUnlockModal(@item.MaNd, '@item.HoTen')">
                                            <i class="bi bi-unlock-fill"></i>
                                        </button>
                                    }
                                }
                                <button type="button" class="btn btn-sm btn-light border shadow-sm text-danger fw-bold ms-1" title="Xóa vĩnh viễn"
                                        onclick="openDeleteModal(@item.MaNd, '@item.HoTen')">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Modal Khóa -->
<div class="modal fade" id="lockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-lock me-2"></i>Xác nhận khóa tài khoản</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-shield-lock-fill text-danger mb-3" style="font-size: 3.5rem;"></i>
                <p class="fs-5 mb-1">Bạn có chắc chắn muốn khóa tài khoản của</p>
                <h4 class="fw-bold text-danger mb-3" id="lockEmployeeName"></h4>
            </div>
            <div class="modal-footer justify-content-center bg-light border-0 py-3">
                <form method="post" asp-action="Khoa">
                    <input type="hidden" name="id" id="lockEmployeeId" />
                    <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="bi bi-lock-fill me-1"></i> Đồng ý khóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mở Khóa -->
<div class="modal fade" id="unlockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white py-2">
                <h6 class="modal-title fw-bold">Mở khóa tài khoản</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-shield-check text-success display-4"></i>
                <p class="mt-3 mb-0">Kích hoạt lại tài khoản của</p>
                <strong class="text-dark fs-5" id="unlockEmployeeName"></strong>?
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <form method="post" asp-action="MoKhoa">
                    <input type="hidden" name="id" id="unlockEmployeeId" />
                    <button type="button" class="btn btn-light btn-sm px-3 border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success btn-sm px-4 fw-bold shadow-sm">Xác nhận</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thông báo (Thành công / Lỗi) -->
@if (TempData["MessageSuccess_NV"] != null)
{
    <div class="modal fade" id="successModalNV" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-check-circle-fill text-success mb-2" style="font-size: 4rem;"></i>
                    <h5 class="fw-bold text-success mt-2 mb-1">THÀNH CÔNG!</h5>
                    <p class="text-muted small mb-0">@TempData["MessageSuccess_NV"]</p>
                </div>
            </div>
        </div>
    </div>
}
@if (TempData["MessageError_NV"] != null)
{
    <div class="modal fade" id="errorModalNV" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-x-circle-fill text-danger mb-3" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold text-danger mb-2">THẤT BẠI!</h4>
                    <p class="text-dark fs-6 mb-0">@TempData["MessageError_NV"]</p>
                    <button type="button" class="btn btn-dark px-4 fw-bold mt-3" data-bs-dismiss="modal">Đã hiểu</button>
                </div>
            </div>
        </div>
    </div>
}
<!-- Modal Xóa Vĩnh Viễn -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white py-3 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-trash3-fill text-danger me-2"></i>Xác nhận xóa tài khoản</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-warning mb-3" style="font-size: 4rem;"></i>
                <p class="fs-5 mb-1 text-dark">Bạn có chắc chắn muốn xóa vĩnh viễn hồ sơ của</p>
                <h4 class="fw-bold text-danger mb-3" id="deleteEmployeeName"></h4>
                <p class="text-muted small px-4 mb-0">Hành động này không thể hoàn tác. Toàn bộ dữ liệu hồ sơ và ảnh đại diện sẽ bị xóa bỏ hoàn toàn khỏi hệ thống.</p>
            </div>
            <div class="modal-footer justify-content-center bg-light border-0 rounded-bottom-4 py-3">
                <form method="post" asp-action="Xoa">
                    <input type="hidden" name="id" id="deleteEmployeeId" />
                    <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm"><i class="bi bi-trash3-fill me-1"></i> Đồng ý xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openLockModal(id, name) {
        document.getElementById('lockEmployeeId').value = id;
        document.getElementById('lockEmployeeName').textContent = name;
        new bootstrap.Modal(document.getElementById('lockModal')).show();
    }

    function openUnlockModal(id, name) {
        document.getElementById('unlockEmployeeId').value = id;
        document.getElementById('unlockEmployeeName').textContent = name;
        new bootstrap.Modal(document.getElementById('unlockModal')).show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Tự động bật Modal thông báo
        @if (TempData["MessageSuccess_NV"] != null)
        {
                <text>
                    var successModal = new bootstrap.Modal(document.getElementById('successModalNV'));
                    successModal.show();
                    setTimeout(() => successModal.hide(), 2000);
                </text>
        }
        @if (TempData["MessageError_NV"] != null)
        {
                <text>
                    new bootstrap.Modal(document.getElementById('errorModalNV')).show();
                </text>
        }
        const searchInput = document.getElementById('searchInput');
        const employeeRows = document.querySelectorAll('.employee-row');

        searchInput.addEventListener('keyup', function (e) {
            const searchTerm = e.target.value.toLowerCase().trim();

            employeeRows.forEach(row => {
                // Lấy nội dung của tên, liên hệ (sđt, email), và tài khoản
                const name = row.querySelector('.employee-name').textContent.toLowerCase();
                const contact = row.querySelector('.employee-contact').textContent.toLowerCase();
                const username = row.querySelector('.employee-username').textContent.toLowerCase();

                // Ẩn/hiện dòng nếu khớp từ khóa
                if (name.includes(searchTerm) || contact.includes(searchTerm) || username.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
    @* // Hàm chuyển trang chi tiết khi click vào dòng *@
    function goToDetail(e, url) {
        // Kiểm tra: Nếu thẻ người dùng click vào là <a> (nút Sửa, Xem) hoặc <button> (nút Khóa)
        // hoặc nằm bên trong các thẻ này (như icon <i>), thì KHÔNG chuyển trang Chi tiết.
        if (e.target.closest('a') || e.target.closest('button')) {
            return; // Dừng lại, nhường quyền cho nút bấm hoạt động
        }
        
        // Nếu click vào vùng trống của dòng, thì chuyển sang URL chi tiết
        window.location.href = url;
    }
    function openDeleteModal(id, name) {
        document.getElementById('deleteEmployeeId').value = id;
        document.getElementById('deleteEmployeeName').textContent = name;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

</script>
