@model CinemaVN.Models.PhongChieu

@{
    ViewData["Title"] = "Thêm Phòng Chiếu";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-label text-uppercase mb-0"><i class="bi bi-plus-square-dotted me-2"></i>THÊM PHÒNG CHIẾU</h2>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    <i class="bi bi-info-circle me-2"></i>Thông tin phòng chiếu
                </div>
                <div class="card-body bg-light p-4">
                    <form asp-action="Them" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Tên Phòng Chiếu <span class="text-danger">*</span></label>
                            <input asp-for="TenPc" class="form-control form-control-lg shadow-sm" placeholder="VD: CINEMA 01, Phòng chiếu 1..." required autofocus />
                            <span asp-validation-for="TenPc" class="text-danger small"></span>
                        </div>

                        <input type="hidden" asp-for="SucChua" value="" />

                        <hr class="my-4" />
                        <button type="submit" class="btn btn-success px-5 py-2 fw-bold shadow">
                            <i class="bi bi-check-lg me-2"></i>Khởi tạo Phòng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 border-start border-4 border-info">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-info mb-3"><i class="bi bi-lightbulb-fill me-2"></i>Cơ chế tự động</h5>
                    <p class="text-muted">Bạn không cần nhập <strong>Sức chứa</strong> cho phòng chiếu lúc này.</p>
                    
                    <ul class="list-group list-group-flush mb-0">
                        <li class="list-group-item bg-transparent px-0 border-0 d-flex align-items-start">
                            <i class="bi bi-1-circle-fill text-primary mt-1 me-3 fs-5"></i>
                            <div>Tạo tên phòng chiếu (Ví dụ: CINEMA 01).</div>
                        </li>
                        <li class="list-group-item bg-transparent px-0 border-0 d-flex align-items-start">
                            <i class="bi bi-2-circle-fill text-primary mt-1 me-3 fs-5"></i>
                            <div>Trở về danh sách, bấm vào <strong class="text-primary">Cấu hình sơ đồ ghế</strong>.</div>
                        </li>
                        <li class="list-group-item bg-transparent px-0 border-0 d-flex align-items-start">
                            <i class="bi bi-3-circle-fill text-primary mt-1 me-3 fs-5"></i>
                            <div>Thiết lập các hàng ghế (VIP, Thường, Đôi). Hệ thống sẽ <strong>tự động đếm và cập nhật</strong> tổng sức chứa của phòng dựa trên sơ đồ bạn vẽ!</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}