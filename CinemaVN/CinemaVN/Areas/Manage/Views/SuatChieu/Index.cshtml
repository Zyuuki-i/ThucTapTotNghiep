@model IEnumerable<CinemaVN.Models.SuatChieu>
@{
    ViewData["Title"] = "Lịch Chiếu Phim";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";

    // Gom nhóm dữ liệu theo Ngày Chiếu
    var groupedByDate = Model
        .Where(x => x.NgayChieu.HasValue)
        .GroupBy(x => x.NgayChieu.Value.Date)
        .OrderByDescending(g => g.Key)
        .ToList();
}

<div>
    <h2 class="text-label fw-bold mb-2"><i class="bi bi-calendar-check"></i> QUẢN LÝ SUẤT CHIẾU </h2>
    <span class="badge bg-dark text-white shadow-sm fs-6 fw-normal px-3 py-2 mb-2">
        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Chi nhánh: <strong class="text-warning">@ViewBag.TenChiNhanh</strong>
    </span>
</div>

<div class="row align-items-center mb-4 g-3">
    <div class="col-12 col-xl-auto me-auto">
        <a asp-action="Them" class="btn btn-success shadow-sm fw-bold px-4 py-2" style="background-color: #198754;">
            <i class="bi bi-plus-circle me-2"></i>Thêm Lịch Mới
        </a>
    </div>

    <div class="col-12 col-xl-auto">
        <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-center">
        
            <div class="input-group shadow-sm" style="width: 220px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-start-0 ps-0" placeholder="Tìm tên...">
            </div>

            <select name="filterMovie" class="form-select shadow-sm" style="width: 180px;" asp-items="ViewBag.PhimList" onchange="this.form.submit()">
                <option value="">-- Tất cả phim --</option>
            </select>

            <select name="filterRoom" class="form-select shadow-sm" style="width: 150px;" asp-items="ViewBag.RoomList" onchange="this.form.submit()">
                <option value="">-- Tất cả phòng --</option>
            </select>

            <input type="date" name="filterDate" value="@ViewBag.FilterDate" class="form-control shadow-sm" style="width: 140px;" onchange="this.form.submit()" title="Chọn ngày chiếu">

            <div class="btn-group shadow-sm">
                <button type="submit" class="btn btn-primary fw-bold px-3">Lọc</button>
            
                @if (!string.IsNullOrEmpty(ViewBag.SearchString) || ViewBag.FilterDate != null || ViewBag.FilterMovie != null || ViewBag.FilterRoom != null)
                {
                    <a asp-action="Index" class="btn btn-danger" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

@if (!groupedByDate.Any())
{
    <div class="alert alert-secondary text-center py-5 shadow-sm border-0">
        <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
        <h5 class="mt-3">Chưa có lịch chiếu nào.</h5>
    </div>
}
else
{
    @foreach (var dayGroup in groupedByDate)
    {
        string todayStr = dayGroup.Key == DateTime.Now.Date ? " (Hôm nay)" : "";
        <h4 class="fw-bold text-primary mt-4 mb-3 border-bottom pb-2">
            <i class="bi bi-calendar-day me-2"></i>
            @dayGroup.Key.ToString("dd/MM/yyyy") <span class="text-danger">@todayStr</span>
        </h4>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
            @foreach (var item in dayGroup.OrderBy(x => x.GioBd))
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary custom-hover-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-truncate mb-0" title="@item.MaPhimNavigation?.TenPhim">
                                    @item.MaPhimNavigation?.TenPhim
                                </h5>
                                <span class="badge bg-secondary">@item.MaDd</span>
                            </div>
                            
                            <p class="text-muted small mb-3">
                                <i class="bi bi-door-closed-fill text-warning me-1"></i> Phòng: <strong>@item.MaPcNavigation?.TenPc</strong>
                            </p>

                            <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mb-3 border">
                                <div class="text-center px-2">
                                    <span class="d-block small text-muted">Bắt đầu</span>
                                    <strong class="fs-5 text-success">@(item.GioBd.HasValue ? item.GioBd.Value.ToString(@"hh\:mm") : "")</strong>
                                </div>
                                <i class="bi bi-arrow-right text-muted"></i>
                                <div class="text-center px-2">
                                    <span class="d-block small text-muted">Kết thúc</span>
                                    <strong class="fs-5 text-danger">@(item.GioKt.HasValue ? item.GioKt.Value.ToString(@"hh\:mm") : "")</strong>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="text-danger">@(item.GiaGoc.HasValue ? item.GiaGoc.Value.ToString("N0") : "0")đ</strong>
                                
                                <div class="btn-group">
                                    <a asp-action="Sua" asp-route-id="@item.MaSc" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.MaSc">Xóa</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<style>
    /* Hiệu ứng hover cho card suất chiếu */
    .custom-hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>
@* xóa xuất chiếu *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-octagon-fill me-2"></i>Xác nhận hủy suất chiếu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-calendar-x text-danger" style="font-size: 3.5rem;"></i>
                </div>
                <p class="fs-5 mb-1">Bạn có chắc chắn muốn xóa suất chiếu này?</p>
                <h4 class="fw-bold text-danger mb-3" id="delMovieName"></h4>
                <p class="text-muted" id="delShowTime"></p>
                
                <div class="alert alert-warning text-start small mb-0 shadow-sm border-0">
                    <i class="bi bi-info-circle-fill me-1"></i> <strong>Lưu ý:</strong> Hành động này sẽ gỡ bỏ suất chiếu khỏi lịch và không thể hoàn tác.
                </div>
            </div>
            <div class="modal-footer justify-content-center bg-light border-0 py-3">
                <form method="post" asp-action="Xoa">
                    <input type="hidden" name="id" id="delMaSc" />
                    <button type="button" class="btn btn-secondary px-4 fw-bold shadow-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">Đồng ý xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget; 
                var id = button.getAttribute('data-id');
                var movie = button.getAttribute('data-movie');
                var time = button.getAttribute('data-time');

                document.getElementById('delMaSc').value = id;
                document.getElementById('delMovieName').textContent = movie;
                document.getElementById('delShowTime').textContent = "Giờ chiếu: " + time;
            });
        }

        // Tự động bật Modal thông báo Thành công/Lỗi 
        @if (TempData["MessageSuccess_SC"] != null)
        {
                <text>
                    var successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    successModal.show();
                    setTimeout(() => successModal.hide(), 2000);
                </text>
        }
    });
       

</script>