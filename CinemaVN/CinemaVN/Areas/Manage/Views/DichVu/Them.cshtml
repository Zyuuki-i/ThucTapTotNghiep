@{
    ViewData["Title"] = "Nhập Hàng Vào Kho";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
    // Lấy danh sách dịch vụ từ Controller truyền sang
    var danhSachDichVu = ViewBag.DanhSachDichVu as List<CinemaVN.Models.DichVu>;
}

<div class="container mt-4" style="max-width: 800px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-label text-uppercase mb-0 fw-bold">
            <i class="bi bi-box-arrow-in-down text-primary me-2"></i>NHẬP HÀNG VÀO KHO
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm fw-bold">
            <i class="bi bi-arrow-left"></i> Về kho hàng
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-dark text-white fw-bold py-3 d-flex align-items-center">
            <i class="bi bi-boxes fs-5 me-2 text-warning"></i> Cập nhật tồn kho chi nhánh: @ViewBag.TenChiNhanh
        </div>
        <div class="card-body p-4 p-md-5 bg-light">
            
            <!-- Không cần multipart/form-data nữa vì không upload ảnh -->
            <form asp-action="Them" method="post">
                
                <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 p-3 d-flex align-items-center">
                    <i class="bi bi-info-circle-fill text-info fs-3 me-3"></i>
                    <span class="text-dark">
                        Quản lý chỉ có thể nhập hàng từ <b>Danh mục sản phẩm của Trụ sở</b>. Nếu hàng đã có sẵn, hệ thống sẽ tự động cộng dồn số lượng.
                    </span>
                </div>

                <div class="row g-4">
                    <!-- CHỌN MẶT HÀNG TỪ DATABASE -->
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Chọn Dịch Vụ / Sản Phẩm <span class="text-danger">*</span></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-tag-fill"></i></span>
                            <select name="MaDv" class="form-select form-select-lg border-start-0 text-dark fw-bold" required>
                                <!-- Nếu không có SelectedMaDv thì mặc định chọn dòng này -->
                                @if (ViewBag.SelectedMaDv == null)
                                {
                                    <option value="" disabled selected>-- Chọn mặt hàng cần nhập --</option>
                                }
                                else
                                {
                                    <option value="" disabled>-- Chọn mặt hàng cần nhập --</option>
                                }

                                @if (danhSachDichVu != null)
                                {
                                    foreach (var dv in danhSachDichVu)
                                    {
                                        // TỰ ĐỘNG CHỌN SẴN NẾU TRÙNG MÃ
                                        if (ViewBag.SelectedMaDv != null && ViewBag.SelectedMaDv == dv.MaDv)
                                        {
                                            <option value="@dv.MaDv" selected>@dv.TenDv - @dv.LoaiDv (@dv.Gia.ToString("N0") VNĐ)</option>
                                        }
                                        else
                                        {
                                            <option value="@dv.MaDv">@dv.TenDv - @dv.LoaiDv (@dv.Gia.ToString("N0") VNĐ)</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- NHẬP SỐ LƯỢNG -->
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Số lượng nhập thêm <span class="text-danger">*</span></label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-success border-end-0"><i class="bi bi-plus-circle-fill"></i></span>
                            <input type="number" name="SoLuongNhap" class="form-control form-control-lg border-start-0 fw-bold" min="1" value="10" required />
                            <span class="input-group-text bg-light fw-bold text-muted">Sản phẩm</span>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 text-end border-top">
                    <button type="submit" class="btn btn-success px-5 py-3 fw-bold shadow-lg rounded-3 fs-5">
                        <i class="bi bi-box-arrow-in-down-right me-2"></i>XÁC NHẬN NHẬP KHO
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>