@model IEnumerable<CinemaVN.Models.PhieuNhap>
@{
    ViewData["Title"] = "Lịch Sử Nhập Hàng";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
}

<div class="container-fluid px-0 mt-3 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="fw-bold text-uppercase"><i class="bi bi-clock-history text-primary me-2"></i> LỊCH SỬ NHẬP HÀNG</h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái duyệt phiếu nhập kho của chi nhánh.</p>
        </div>
        <div>
            <a asp-action="TaoPhieuNhap" class="btn btn-primary shadow fw-bold px-4 py-2 text-uppercase">
                <i class="bi bi-plus-circle me-2"></i> Tạo Phiếu Mới
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 py-2 ms-2"><i class="bi bi-arrow-left"></i> Về Kho</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3">
        <div class="card-body p-3">
            <form method="get" asp-action="LichSuNhap">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="small fw-bold text-muted">Từ khóa tìm kiếm</label>
                        <input type="text" name="searchStr" value="@ViewBag.SearchStr" class="form-control" placeholder="Mã phiếu, Nhà cung cấp..." />
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted">Từ ngày</label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted">Đến ngày</label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted">Trạng thái</label>
                        <select name="status" class="form-select">
                            <option value="">-- Tất cả --</option>
                            <option value="0" selected="@(ViewBag.Status == 0)">Chờ duyệt</option>
                            <option value="1" selected="@(ViewBag.Status == 1)">Đã duyệt</option>
                            <option value="2" selected="@(ViewBag.Status == 2)">Từ chối</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-muted">Sắp xếp</label>
                        <select name="sortOrder" class="form-select">
                            <option value="">Mới nhất (Mặc định)</option>
                            <option value="ngay_asc" selected="@(ViewBag.SortOrder == "ngay_asc")">Cũ nhất</option>
                            <option value="tien_desc" selected="@(ViewBag.SortOrder == "tien_desc")">Tổng tiền giảm dần</option>
                            <option value="tien_asc" selected="@(ViewBag.SortOrder == "tien_asc")">Tổng tiền tăng dần</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex gap-1">
                        <button type="submit" class="btn btn-primary w-100 fw-bold" title="Lọc dữ liệu"><i class="bi bi-funnel-fill"></i></button>
                        <a asp-action="LichSuNhap" class="btn btn-secondary fw-bold" title="Xóa bộ lọc"><i class="bi bi-arrow-clockwise"></i></a>
                    </div>
                </div>
            </form>
        </div>

    </div>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4 py-3">Mã Phiếu</th>
                        <th class="py-3">Ngày tạo</th>
                        <th class="py-3">Nhà cung cấp</th>
                        <th class="py-3">Người tạo</th>
                        <th class="text-end py-3">Tổng tiền</th>
                        <th class="text-center py-3">Trạng thái</th>
                        <th class="text-end pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">Chi nhánh chưa có lịch sử nhập hàng nào.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#PN-@item.MaPn</td>
                            <td>@item.NgayNhap?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong class="text-dark">@item.NhaCungCap</strong></td>
                            <td><span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i> @item.MaNdNavigation?.HoTen</span></td>
                            <td class="text-end fw-bold text-danger">@item.TongTien?.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (item.TrangThai == 0)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-hourglass-split me-1"></i> Chờ duyệt</span>
                                }
                                else if (item.TrangThai == 1)
                                {
                                    <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Đã duyệt (Đã nhập kho)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2"><i class="bi bi-x-circle me-1"></i> Từ chối</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="ChiTietPhieuNhap" asp-route-id="@item.MaPn" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalChiTiet" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-list-check me-2"></i>Chi tiết phiếu nhập <span id="lblMaPN" class="text-warning"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên Sản Phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end pe-4">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody id="chiTietBody">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function xemChiTiet(id) {
    document.getElementById('lblMaPN').innerText = '#PN-' + id;
    document.getElementById('chiTietBody').innerHTML = '<tr><td colspan="4" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>';
        
    var modal = new bootstrap.Modal(document.getElementById('modalChiTiet'));
    modal.show();

    fetch(`/Manage/DichVu/GetChiTietPhieuNhap/${id}`)
    .then(res => res.json())
    .then(res => {
    if(res.success) {
    let html = '';
    res.data.forEach(item => {
    html += `
    <tr>
    <td class="ps-4 fw-bold text-dark">${item.tenDv}</td>
    <td class="text-center"><span class="badge bg-secondary">${item.soLuong}</span></td>
    <td class="text-end">${item.donGia.toLocaleString()}đ</td>
    <td class="text-end pe-4 fw-bold text-danger">${item.thanhTien.toLocaleString()}đ</td>
    </tr>
    `;
    });
    document.getElementById('chiTietBody').innerHTML = html;
    }
    });
    }
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["Success"] != null)
    {
        <text>
            Swal.fire({
            toast: true, position: 'top-end', icon: 'success',
            title: '@Html.Raw(TempData["Success"])',
            showConfirmButton: false, timer: 4000, timerProgressBar: true
            });
        </text>
    }
    });
</script>