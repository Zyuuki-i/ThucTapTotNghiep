@model IEnumerable<CinemaVN.Models.Kho>
@{
    ViewData["Title"] = "Quản lý Kho Dịch Vụ";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
    int totalItems = Model.Count();
    int outOfStock = Model.Count(k => k.SoLuongTon == null || k.SoLuongTon <= 0);
    int inStock = totalItems - outOfStock;
}

<div class="container-fluid px-0 mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h2 class="text-label fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i> Kho Dịch Vụ & Sản Phẩm</h2>
            <span class="badge bg-dark text-white shadow-sm fs-6 fw-normal px-3 py-2">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Chi nhánh: <strong class="text-warning">@ViewBag.TenChiNhanh</strong>
            </span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="LichSuNhap" class="btn btn-outline-dark shadow fw-bold px-4 py-2 text-uppercase">
                <i class="bi bi-clock-history me-2"></i> Lịch sử nhập
            </a>
            <a asp-action="TaoPhieuNhap" class="btn btn-primary shadow fw-bold px-4 py-2 text-uppercase">
                <i class="bi bi-plus-circle me-2"></i> Tạo Phiếu Nhập
            </a>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-boxes text-primary fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Tổng loại sản phẩm</p>
                        <h3 class="mb-0 fw-bold">@totalItems</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-check2-circle text-success fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Còn hàng</p>
                        <h3 class="mb-0 fw-bold text-success">@inStock</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-4 border-danger h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-exclamation-octagon text-danger fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">Hết hàng (Cần nhập)</p>
                        <h3 class="mb-0 fw-bold text-danger">@outOfStock</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body py-3 px-4 d-flex justify-content-between align-items-center bg-light rounded-3">
            <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-list-task me-2"></i>Danh sách trong kho</h6>
            <div class="input-group" style="width: 350px;">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm tên dịch vụ, loại...">
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="serviceTable">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 px-4 text-start" style="width: 35%;">Thông tin Dịch vụ</th>
                        <th class="py-3 px-4 text-start" style="width: 20%;">Loại</th>
                        <th class="py-3 px-4 text-end" style="width: 15%;">Đơn giá</th>
                        <th class="py-3 px-4 text-center" style="width: 15%;">Số lượng tồn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Kho chi nhánh này hiện đang trống. Vui lòng nhập thêm dịch vụ!
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        string imgUrl = string.IsNullOrEmpty(item.MaDvNavigation?.HinhAnh)
                            ? "/images/default-service.png"
                            : $"/images/dichvu/{item.MaDvNavigation.HinhAnh}";

                        <tr class="service-row">
                            <td class="px-4 py-3 text-start">
                                <div class="d-flex align-items-center">
                                    <img src="@imgUrl" class="rounded shadow-sm me-3 border" style="width: 60px; height: 60px; object-fit: cover;" alt="Service Image" />
                                    <div>
                                        <strong class="d-block text-dark fs-6 service-name">@item.MaDvNavigation?.TenDv</strong>
                                        <span class="small text-muted">Mã: DV-@item.MaDv</span>
                                    </div>
                                </div>
                            </td>
                            
                            <td class="px-4 text-start">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1 service-category">
                                    @item.MaDvNavigation?.LoaiDv
                                </span>
                            </td>

                            <td class="px-4 text-end fw-bold text-primary">
                                @(item.MaDvNavigation?.Gia.ToString("N0")) đ
                            </td>

                            <td class="px-4 text-center">
                                @if (item.SoLuongTon == null || item.SoLuongTon == 0)
                                {
                                    <span class="badge bg-danger px-3 py-2 fs-6 shadow-sm">Hết hàng</span>
                                }
                                else if (item.SoLuongTon <= 10)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm" title="Sắp hết hàng">@item.SoLuongTon</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">@item.SoLuongTon</span>
                                }
                            </td>

                           
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('searchInput');
        const serviceRows = document.querySelectorAll('.service-row');

        searchInput.addEventListener('keyup', function (e) {
            const searchTerm = e.target.value.toLowerCase().trim();

            serviceRows.forEach(row => {
                const name = row.querySelector('.service-name').textContent.toLowerCase();
                const category = row.querySelector('.service-category').textContent.toLowerCase();

                if (name.includes(searchTerm) || category.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
</script>