@model IEnumerable<CinemaVN.Areas.Manage.Controllers.BaoCaoController.ThongKeNgay>
@{
    ViewData["Title"] = "Báo Cáo & Thống Kê";
    Layout = "~/Areas/Manage/Views/Shared/_ManageLayout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid px-0 mt-3 mb-5 report-container">
    
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3 no-print">
        <div>
            <h2 class="text-label fw-bold mb-1 "><i class="bi bi-bar-chart-line-fill text-primary me-2"></i> Báo Cáo Doanh Thu</h2>
            <span class="badge bg-dark text-white shadow-sm fs-6 fw-normal px-3 py-2">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Chi nhánh: <strong class="text-warning">@ViewBag.TenChiNhanh</strong>
            </span>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-primary shadow fw-bold px-4 py-2 text-uppercase rounded-pill">
                <i class="bi bi-printer-fill me-2"></i> In Báo Cáo
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3 no-print">
        <div class="card-body p-3">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-end justify-content-center">
                    <div class="col-md-3">
                        <label class="small fw-bold text-muted">Từ ngày</label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="small fw-bold text-muted">Đến ngày</label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
                    </div>
                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="print-only text-center mb-4">
        <h2 class="fw-bold text-uppercase">BÁO CÁO DOANH THU HOẠT ĐỘNG</h2>
        <h5 class="text-muted">Chi nhánh: @ViewBag.TenChiNhanh</h5>
        <p class="mb-0">Kỳ báo cáo: Từ @ViewBag.FromDate đến @ViewBag.ToDate</p>
        <p class="small text-muted">Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        <hr class="border-dark border-2 my-3" />
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-4 border-primary h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3"><i class="bi bi-receipt text-primary fs-3"></i></div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">TỔNG ĐƠN HÀNG</p>
                        <h3 class="mb-0 fw-bold text-primary">@ViewBag.TongDonHang.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-4 border-info h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle me-3"><i class="bi bi-ticket-detailed text-info fs-3"></i></div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">VÉ BÁN RA</p>
                        <h3 class="mb-0 fw-bold text-info">@ViewBag.TongVe.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-4 border-warning h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3"><i class="bi bi-cup-straw text-warning fs-3"></i></div>
                    <div>
                        <p class="text-muted small mb-0 fw-bold text-uppercase">BẮP NƯỚC (SP)</p>
                        <h3 class="mb-0 fw-bold text-warning">@ViewBag.TongDichVu.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm border-start border-4 border-success h-100 rounded-3 bg-success bg-opacity-10">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="bg-success bg-opacity-25 p-3 rounded-circle me-3"><i class="bi bi-cash-coin text-success fs-3"></i></div>
                    <div>
                        <p class="text-dark small mb-0 fw-bold text-uppercase">TỔNG DOANH THU</p>
                        <h4 class="mb-0 fw-bold text-success">@ViewBag.TongDoanhThu.ToString("N0") đ</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-3 no-print">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-graph-up-arrow me-2"></i>Biểu đồ doanh thu theo ngày</h6>
        </div>
        <div class="card-body">
            <canvas id="revenueChart" height="80"></canvas>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden page-break-auto">
        <div class="card-header bg-dark text-white py-3 no-print">
            <h6 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>Bảng chi tiết doanh thu</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-center">STT</th>
                        <th class="py-3 px-4">Ngày giao dịch</th>
                        <th class="py-3 px-4 text-center">Số lượng vé</th>
                        <th class="py-3 px-4 text-center">Số lượng Bắp nước</th>
                        <th class="py-3 px-4 text-end">Doanh thu ngày</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">Không có dữ liệu giao dịch trong khoảng thời gian này!</td></tr>
                    }
                    @{ int stt = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-muted">@stt</td>
                            <td class="px-4 fw-bold">@item.Ngay</td>
                            <td class="text-center">@item.SoVe</td>
                            <td class="text-center">@item.SoDichVu</td>
                            <td class="px-4 text-end fw-bold text-danger">@item.DoanhThu.ToString("N0") đ</td>
                        </tr>
                        stt++;
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-dark">
                        <tr>
                            <td colspan="2" class="text-end fw-bold fs-5">TỔNG CỘNG KỲ NÀY:</td>
                            <td class="text-center fw-bold fs-5 text-info">@ViewBag.TongVe.ToString("N0")</td>
                            <td class="text-center fw-bold fs-5 text-warning">@ViewBag.TongDichVu.ToString("N0")</td>
                            <td class="text-end px-4 fw-bold fs-5 text-success">@ViewBag.TongDoanhThu.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <div class="row text-center pt-4 mt-5 print-only">
        <div class="col-6">
            <p class="fw-bold mb-5 pb-5">Người lập báo cáo<br><small class="text-muted fw-normal">(Ký, ghi rõ họ tên)</small></p>
        </div>
        <div class="col-6">
            <p class="fw-bold mb-5 pb-5">Quản lý chi nhánh xác nhận<br><small class="text-muted fw-normal">(Ký, đóng dấu)</small></p>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
        var dataValues = @Html.Raw(Json.Serialize(ViewBag.ChartData));

        var ctx = document.getElementById('revenueChart').getContext('2d');
        var revenueChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: dataValues,
                    backgroundColor: 'rgba(25, 135, 84, 0.2)', 
                    borderColor: 'rgba(25, 135, 84, 1)',
                    borderWidth: 3,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: 'rgba(25, 135, 84, 1)',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    fill: true,
                    tension: 0.3 
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) { label += ': '; }
                                if (context.parsed.y !== null) {
                                    label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: function(value) { return new Intl.NumberFormat('vi-VN').format(value) + ' đ'; } }
                    }
                }
            }
        });
    });
</script>

<style>
    .print-only {
    display: none;
    }
    @@media print {
    body * {
    visibility: hidden;
    }
    .report-container, .report-container * {
    visibility: visible;
    }

    .report-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    margin: 0 !important;
    padding: 0 !important;
    }
    .no-print {
    display: none !important;
    }
    .print-only {
    display: block !important;
    }
    .row {
    display: flex !important;
    flex-wrap: nowrap !important;
    width: 100%;
    }

    .col-md-3 {
    width: 25% !important;
    flex: 0 0 25% !important;
    max-width: 25% !important;
    padding: 0 10px !important;
    }
    .card {
    border: none !important;
    box-shadow: none !important;
    }

    .table {
    width: 100% !important;
    border-collapse: collapse !important;
    margin-bottom: 20px !important;
    }

    .table th, .table td {
    border: 1px solid #000 !important;
    padding: 8px !important;
    color: #000 !important;
    }
    .table-dark th, .table-dark td, .table-light th {
    background-color: #f8f9fa !important;
    color: #000 !important;
    }
    @@page {
    margin: 1.5cm; 
    }
    tr {
    page-break-inside: avoid;
    page-break-after: auto;
    }
    }
</style>