@inject IHttpContextAccessor HttpContextAccessor
@{
    string name = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CinemaVN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <aside class="admin-sidebar shadow-sm">
            <div class="text-center mb-4">
                <a href="/" class="text-decoration-none">
                    <img src="~/images/logo/CinemaVN.png" alt="CinemaVN Logo" class="img-fluid mb-2" style="max-height: 60px;" />
                </a>
                <div class="sidebar-title mt-2">Quản Lý Chi Nhánh</div>
            </div>

            <nav class="nav flex-column mt-3" id="admin-nav">
                <a class="sidebar-link mb-1" asp-area="Manage" asp-controller="PhongChieu" asp-action="Index">
                    <i class="bi bi-door-closed"></i> Quản Lý Phòng Chiếu
                </a>
                <a class="sidebar-link mb-1" asp-area="Manage" asp-controller="SuatChieu" asp-action="Index">
                    <i class="bi bi-calendar-check"></i> Quản Lý Lịch Chiếu
                </a>
                <a class="sidebar-link mb-1" asp-area="Manage" asp-controller="DichVu" asp-action="Index">
                    <i class="bi bi-cup-straw"></i> Quản Lý Dịch Vụ
                </a>
                <a class="sidebar-link mb-1" asp-area="Manage" asp-controller="Ghe" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap"></i> Quản Lý Sơ Đồ Ghế
                </a>
                <a class="sidebar-link mb-1" asp-area="Manage" asp-controller="NguoiDung" asp-action="Index">
                    <i class="bi bi-person"></i> Quản Lý Nhân Viên & Tài Khoản
                </a>
                <a class="sidebar-link mb-1" asp-area="Manage" asp-controller="BaoCao" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i> Báo Cáo & Thống Kê
                </a>
                <hr class="text-muted" />
                <a class="sidebar-link text-danger" asp-area="" asp-controller="NguoiDung" asp-action="dangXuat">
                    <i class="bi bi-box-arrow-right"></i> Đăng Xuất
                </a>
            </nav>
        </aside>

        <div class="admin-main-content">
            <header class="bg-white border-bottom p-3 mb-4 d-flex justify-content-between align-items-center shadow-sm">
                <span class="text-muted">Chào mừng trở lại, <strong>@name</strong></span>
                <div class="user-menu">
                    <span class="badge badge-soft-success px-3 py-2">
                        Time: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
            </header>

            <main role="main" class="px-4 pb-5">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/site.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
         document.addEventListener("DOMContentLoaded", function () {
            // Lấy đường dẫn hiện tại của trình duyệt
            const currentPath = window.location.pathname;

            // Chọn tất cả các thẻ <a> có class 'sidebar-link' bên trong #admin-nav
            const navLinks = document.querySelectorAll('#admin-nav a.sidebar-link');

            navLinks.forEach(function (link) {
                // Lấy giá trị thuộc tính href
                const linkHref = link.getAttribute('href');

                // Thực hiện kiểm tra logic tương tự
                if (currentPath === linkHref || (linkHref !== "/" && currentPath.startsWith(linkHref))) {
                    link.classList.add('active');
                } else {
                    // Đảm bảo loại bỏ class active nếu không khớp (đề phòng trường hợp cache)
                    link.classList.remove('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>